{
	"routine": "dlarfgp",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DLARFGP( N, ALPHA, X, INCX, TAU )",
	"returns": {
		"kind": "array",
		"param": "x"
	},
	"params": [
		{
			"name": "N",
			"fortran": "N",
			"position": 1,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "alpha",
			"fortran": "ALPHA",
			"position": 2,
			"role": "scalar",
			"dtype": "float64",
			"intent": "inout",
			"element": true
		},
		{
			"name": "x",
			"fortran": "X",
			"position": 3,
			"role": "vector",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"1+(N-2)*ABS(INCX)"
			],
			"length": {
				"fortran": "1+(N-2)*ABS(INCX)",
				"js": "1 + (N - 2) * abs( incx )"
			}
		},
		{
			"name": "incx",
			"fortran": "INCX",
			"position": 4,
			"role": "inc",
			"dtype": "int32",
			"intent": "in",
			"of": "X"
		},
		{
			"name": "tau",
			"fortran": "TAU",
			"position": 5,
			"role": "scalar",
			"dtype": "float64",
			"intent": "out",
			"element": true
		}
	],
	"checks": [],
	"quickReturn": [
		{
			"fortran": "N.LE.0",
			"js": "N <= 0",
			"sets": [
				"TAU = ZERO"
			]
		}
	],
	"overrides": [
		{
			"reason": "Callers pass ALPHA and TAU as elements of their own arrays (X11(i,i) and TAUP1(i) in dorbdb*, A(i,i) and TAU(i) in dgeqr2p), which DLARFGP updates in place, so they keep `x, offsetX` instead of a length-1 array every caller would copy in and out (S10, ruled 2026-11-19).",
			"set": {
				"params.ALPHA.element": true,
				"params.TAU.element": true
			}
		}
	]
}
