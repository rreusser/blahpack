{
	"routine": "zlarfx",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZLARFX( SIDE, M, N, V, TAU, C, LDC, WORK )",
	"returns": {
		"kind": "array",
		"param": "C"
	},
	"params": [
		{
			"name": "side",
			"fortran": "SIDE",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in",
			"reference": "-   `= 'L'`: form  $H \\, C$\n-   `= 'R'`: form  $C \\, H$"
		},
		{
			"name": "M",
			"fortran": "M",
			"position": 2,
			"role": "dim",
			"dtype": "int32",
			"intent": "in",
			"reference": "The number of rows of the matrix C."
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in",
			"reference": "The number of columns of the matrix C."
		},
		{
			"name": "v",
			"fortran": "V",
			"position": 4,
			"role": "vector",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"M"
			],
			"length": {
				"fortran": "(M) if SIDE = 'L' or (N) if SIDE = 'R'",
				"js": "( side === 'left' ) ? M : N"
			},
			"reference": "or (N) if `SIDE = 'R'` The vector v in the representation of H."
		},
		{
			"name": "tau",
			"fortran": "TAU",
			"position": 5,
			"role": "scalar",
			"dtype": "complex128",
			"intent": "in",
			"reference": "The value $\\tau$ in the representation of H."
		},
		{
			"name": "C",
			"fortran": "C",
			"position": 6,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDC",
				"N"
			],
			"ld": "LDC",
			"rows": {
				"fortran": "M",
				"js": "M"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			},
			"reference": "On entry, the m by n matrix C. On exit, C is overwritten by the matrix $H \\, C$ if `SIDE = 'L'`, or $C \\, H$ if `SIDE = 'R'`."
		},
		{
			"name": "ldc",
			"fortran": "LDC",
			"position": 7,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "C",
			"reference": "The leading dimension of the array C. $\\mathrm{LDC} \\ge \\max (1,M)$."
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 8,
			"role": "workspace",
			"dtype": "complex128",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "(N) if SIDE = 'L' or (M) if SIDE = 'R'",
				"js": "( side === 'left' ) ? N : M"
			},
			"minLength": {
				"fortran": "N",
				"js": "N",
				"source": "dimension"
			},
			"reference": "or (M) if `SIDE = 'R'` `WORK` is not referenced if H has order \\< 11."
		}
	],
	"checks": [],
	"quickReturn": [
		{
			"fortran": "TAU.EQ.ZERO",
			"js": "real( tau ) === 0 && imag( tau ) === 0"
		}
	]
}
