	"checks": [
		{
			"info": -1,
			"param": "TRANS",
			"kind": "enum",
			"fortranValues": "CNT",
			"values": [
				"conjugate-transpose",
				"no-transpose",
				"transpose"
			],
			"fortran": ".NOT.NOTRAN .AND. .NOT.( TRANS.EQ.'T' .OR. TRANS.EQ. 'T' ) .AND. .NOT.( TRANS.EQ.'C' .OR. TRANS.EQ.'C' )",
			"js": "!(trans === 'N' || trans === 'N') && !(trans === 'T' || trans === 'T') && !(trans === 'C' || trans === 'C')"
		},
		{
			"info": -2,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
