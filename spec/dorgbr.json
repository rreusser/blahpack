{
	"routine": "dorgbr",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DORGBR( VECT, M, N, K, A, LDA, TAU, WORK, LWORK, INFO )",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "vect",
			"fortran": "VECT",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "M",
			"fortran": "M",
			"position": 2,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "K",
			"fortran": "K",
			"position": 4,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 5,
			"role": "matrix",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDA",
				"N"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "M",
				"js": "M"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 6,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		},
		{
			"name": "TAU",
			"fortran": "TAU",
			"position": 7,
			"role": "vector",
			"dtype": "float64",
			"intent": "in",
			"dims": [
				"MIN(M,K)"
			],
			"length": {
				"fortran": "MIN(M,K)",
				"js": "min( M, K )"
			}
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 8,
			"role": "workspace",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"MAX(1,LWORK)"
			],
			"minLength": {
				"fortran": "MAX(1,MN)",
				"js": "max( 1, min( M, N ) )",
				"source": "check"
			}
		},
		{
			"name": "lwork",
			"fortran": "LWORK",
			"position": 9,
			"role": "lwork",
			"dtype": "int32",
			"intent": "in",
			"of": "WORK"
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 10,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "VECT",
			"kind": "enum",
			"fortranValues": "PQ",
			"values": [
				"apply-P",
				"apply-Q"
			],
			"fortran": ".NOT.WANTQ .AND. .NOT.LSAME( VECT, 'P' )",
			"js": "vect !== 'apply-Q' && vect !== 'apply-P'"
		},
		{
			"info": -2,
			"param": "M",
			"kind": "nonnegative",
			"fortran": "M.LT.0",
			"js": "M < 0"
		},
		{
			"info": -3,
			"param": "N",
			"kind": "expr",
			"fortran": "N.LT.0 .OR. ( WANTQ .AND. ( N.GT.M .OR. N.LT.MIN( M, K ) ) ) .OR. ( .NOT.WANTQ .AND. ( M.GT.N .OR. M.LT. MIN( N, K ) ) )",
			"js": "(N < 0 || (vect === 'apply-Q' && (N > M || N < min( M, K )))) || (vect !== 'apply-Q' && (M > N || M < min( N, K )))"
		},
		{
			"info": -4,
			"param": "K",
			"kind": "nonnegative",
			"fortran": "K.LT.0",
			"js": "K < 0"
		},
		{
			"info": -6,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,M)",
				"js": "max( 1, M )"
			},
			"fortran": "LDA.LT.MAX( 1, M )",
			"js": "lda < max( 1, M )",
			"rowMajor": "lda < max( 1, N )"
		}
	],
	"quickReturn": [
		{
			"fortran": "M.EQ.0 .OR. N.EQ.0",
			"js": "M === 0 || N === 0",
			"sets": [
				"WORK( 1 ) = 1"
			]
		}
	]
}
