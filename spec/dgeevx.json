				"compute-vectors"
			],
			"fortran": "( .NOT.WANTVR ) .AND. ( .NOT.LSAME( JOBVR, 'N' ) )",
			"js": "jobvr !== 'compute-vectors' && jobvr !== 'no-vectors'"
		},
		{
			"info": -4,
			"param": "SENSE",
			"kind": "expr",
			"fortran": ".NOT.( WNTSNN .OR. WNTSNE .OR. WNTSNB .OR. WNTSNV ) .OR. ( ( WNTSNE .OR. WNTSNB ) .AND. .NOT.( WANTVL .AND. WANTVR ) )",
			"js": "!(((sense === 'none' || sense === 'eigenvalues') || sense === 'both') || sense === 'right-vectors') || ((sense === 'eigenvalues' || sense === 'both') && !(jobvl === 'compute-vectors' && jobvr === 'compute-vectors'))"
		},
		{
			"info": -5,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
