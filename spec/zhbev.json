{
	"routine": "zhbev",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZHBEV( JOBZ, UPLO, N, KD, AB, LDAB, W, Z, LDZ, WORK,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "jobz",
			"fortran": "JOBZ",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "uplo",
			"fortran": "UPLO",
			"position": 2,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "kd",
			"fortran": "KD",
			"position": 4,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "AB",
			"fortran": "AB",
			"position": 5,
			"role": "banded",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDAB",
				"N"
			],
			"ld": "LDAB",
			"rows": {
				"fortran": "KD+1",
				"js": "kd + 1"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldab",
			"fortran": "LDAB",
			"position": 6,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "AB"
		},
		{
			"name": "w",
			"fortran": "W",
			"position": 7,
			"role": "vector",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "Z",
			"fortran": "Z",
			"position": 8,
			"role": "banded",
			"dtype": "complex128",
			"intent": "out",
			"dims": [
				"LDZ",
				"N"
			],
			"ld": "LDZ",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldz",
			"fortran": "LDZ",
			"position": 9,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "Z"
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 10,
			"role": "workspace",
			"dtype": "complex128",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			},
			"minLength": {
				"fortran": "N",
				"js": "N",
				"source": "dimension"
			}
		},
		{
			"name": "RWORK",
			"fortran": "RWORK",
			"position": 11,
			"role": "workspace",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"MAX(1,3*N-2)"
			],
			"length": {
				"fortran": "MAX(1,3*N-2)",
				"js": "max( 1, 3 * N - 2 )"
			},
			"minLength": {
				"fortran": "MAX(1,3*N-2)",
				"js": "max( 1, 3 * N - 2 )",
				"source": "dimension"
			}
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 12,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "JOBZ",
			"kind": "enum",
			"fortranValues": "NV",
			"values": [
				"no-vectors",
				"compute-vectors"
			],
			"fortran": ".NOT.( WANTZ .OR. LSAME( JOBZ, 'N' ) )",
			"js": "!(jobz === 'compute-vectors' || jobz === 'no-vectors')"
		},
		{
			"info": -2,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.( LOWER .OR. LSAME( UPLO, 'U' ) )",
			"js": "!(uplo === 'lower' || uplo === 'upper')"
		},
		{
			"info": -3,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -4,
			"param": "KD",
			"kind": "nonnegative",
			"fortran": "KD.LT.0",
			"js": "kd < 0"
		},
		{
			"info": -6,
			"param": "LDAB",
			"kind": "ld",
			"matrix": "AB",
			"min": {
				"fortran": "KD+1",
				"js": "kd + 1"
			},
			"fortran": "LDAB.LT.KD+1",
			"js": "ldab < kd + 1"
		},
		{
			"info": -9,
			"param": "LDZ",
			"kind": "expr",
			"fortran": "LDZ.LT.1 .OR. ( WANTZ .AND. LDZ.LT.N )",
			"js": "ldz < 1 || (jobz === 'compute-vectors' && ldz < N)"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0",
			"js": "N === 0"
		}
	]
}
