			}
		},
		{
			"name": "DU2",
			"fortran": "DU2",
			"position": 7,
			"role": "vector",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"N-2"
			],
			"length": {
				"fortran": "N-2",
