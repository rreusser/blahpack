	],
	"checks": [
		{
			"info": -1,
			"param": "SIDE",
			"kind": "enum",
			"fortranValues": "BLR",
			"values": [
				"both",
				"left",
				"right"
			],
			"fortran": ".NOT.RIGHTV .AND. .NOT.LEFTV",
			"js": "!(side === 'right' || side === 'both') && !(side === 'left' || side === 'both')"
		},
		{
			"info": -2,
			"param": "HOWMNY",
			"kind": "enum",
			"fortranValues": "ABS",
			"values": [
				"all",
				"backtransform",
				"selected"
			],
			"fortran": ".NOT.ALLV .AND. .NOT.OVER .AND. .NOT.SOMEV",
			"js": "howmny !== 'all' && howmny !== 'backtransform' && howmny !== 'selected'"
		},
		{
			"info": -4,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -6,
			"param": "LDT",
			"kind": "ld",
			"matrix": "T",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDT.LT.MAX( 1, N )",
			"js": "ldt < max( 1, N )"
		},
		{
			"info": -8,
			"param": "LDVL",
			"kind": "expr",
			"fortran": "LDVL.LT.1 .OR. ( LEFTV .AND. LDVL.LT.N )",
			"js": "ldvl < 1 || ((side === 'left' || side === 'both') && ldvl < N)",
			"rowMajor": "ldvl<1||((side==='left'||side==='both')&&ldvl<max(1,mm))"
		},
		{
			"info": -10,
			"param": "LDVR",
			"kind": "expr",
			"fortran": "LDVR.LT.1 .OR. ( RIGHTV .AND. LDVR.LT.N )",
			"js": "ldvr < 1 || ((side === 'right' || side === 'both') && ldvr < N)",
			"rowMajor": "ldvr<1||((side==='right'||side==='both')&&ldvr<max(1,mm))"
		},
		{
			"info": -11,
			"param": "MM",
			"kind": "expr",
			"fortran": "MM.LT.M",
			"js": null
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0",
			"js": "N === 0"
		}
	],
	"tuning": [
