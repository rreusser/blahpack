{
	"routine": "dtgexc",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DTGEXC( WANTQ, WANTZ, N, A, LDA, B, LDB, Q, LDQ, Z,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "wantq",
			"fortran": "WANTQ",
			"position": 1,
			"role": "scalar",
			"dtype": "bool",
			"intent": "in"
		},
		{
			"name": "wantz",
			"fortran": "WANTZ",
			"position": 2,
			"role": "scalar",
			"dtype": "bool",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 4,
			"role": "matrix",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDA",
				"N"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 5,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		},
		{
			"name": "B",
			"fortran": "B",
			"position": 6,
			"role": "matrix",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDB",
				"N"
			],
			"ld": "LDB",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldb",
			"fortran": "LDB",
			"position": 7,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "B"
		},
		{
			"name": "Q",
			"fortran": "Q",
			"position": 8,
			"role": "matrix",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDQ",
				"N"
			],
			"ld": "LDQ",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldq",
			"fortran": "LDQ",
			"position": 9,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "Q"
		},
		{
			"name": "Z",
			"fortran": "Z",
			"position": 10,
			"role": "matrix",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDZ",
				"N"
			],
			"ld": "LDZ",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldz",
			"fortran": "LDZ",
			"position": 11,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "Z"
		},
		{
			"name": "ifst",
			"fortran": "IFST",
			"position": 12,
			"role": "scalar",
			"dtype": "int32",
			"intent": "inout",
			"base": 0
		},
		{
			"name": "ilst",
			"fortran": "ILST",
			"position": 13,
			"role": "scalar",
			"dtype": "int32",
			"intent": "inout",
			"base": 0
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 14,
			"role": "workspace",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"MAX(1,LWORK)"
			],
			"minLength": {
				"fortran": "LWMIN",
				"js": null,
				"source": "check"
			}
		},
		{
			"name": "lwork",
			"fortran": "LWORK",
			"position": 15,
			"role": "lwork",
			"dtype": "int32",
			"intent": "in",
			"of": "WORK"
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 16,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -3,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -5,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDA.LT.MAX( 1, N )",
			"js": "lda < max( 1, N )"
		},
		{
			"info": -7,
			"param": "LDB",
			"kind": "ld",
			"matrix": "B",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDB.LT.MAX( 1, N )",
			"js": "ldb < max( 1, N )"
		},
		{
			"info": -9,
			"param": "LDQ",
			"kind": "expr",
			"fortran": "LDQ.LT.1 .OR. WANTQ .AND. ( LDQ.LT.MAX( 1, N ) )",
			"js": "ldq < 1 || (wantq && ldq < max( 1, N ))"
		},
		{
			"info": -11,
			"param": "LDZ",
			"kind": "expr",
			"fortran": "LDZ.LT.1 .OR. WANTZ .AND. ( LDZ.LT.MAX( 1, N ) )",
			"js": "ldz < 1 || (wantz && ldz < max( 1, N ))"
		},
		{
			"info": -12,
			"param": "IFST",
			"kind": "expr",
			"fortran": "IFST.LT.1 .OR. IFST.GT.N",
			"js": "ifst < 1 || ifst > N"
		},
		{
			"info": -13,
			"param": "ILST",
			"kind": "expr",
			"fortran": "ILST.LT.1 .OR. ILST.GT.N",
			"js": "ilst < 1 || ilst > N"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.LE.1",
			"js": "N <= 1"
		}
	],
	"untranslated": [
		"WORK.minLength: local LWMIN is assigned inside nested control flow"
	],
	"overrides": [
		{
			"reason": "The JS API takes IFST and ILST 0-based (base.js and its tests index the diagonal with them directly), unlike dtrexc's 1-based IFST/ILST.",
			"set": {
				"params.IFST.base": 0,
				"params.ILST.base": 0
			}
		}
	]
}
