{
	"routine": "ztpqrt2",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZTPQRT2( M, N, L, A, LDA, B, LDB, T, LDT, INFO )",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "M",
			"fortran": "M",
			"position": 1,
