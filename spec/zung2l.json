{
	"routine": "zung2l",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZUNG2L( M, N, K, A, LDA, TAU, WORK, INFO )",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "M",
			"fortran": "M",
			"position": 1,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
