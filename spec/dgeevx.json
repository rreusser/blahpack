			"info": -11,
			"param": "LDVL",
			"kind": "expr",
			"fortran": "LDVL.LT.1 .OR. ( WANTVL .AND. LDVL.LT.N )",
			"js": "ldvl < 1 || (jobvl === 'compute-vectors' && ldvl < N)"
		},
		{
			"info": -13,
			"param": "LDVR",
			"kind": "expr",
			"fortran": "LDVR.LT.1 .OR. ( WANTVR .AND. LDVR.LT.N )",
