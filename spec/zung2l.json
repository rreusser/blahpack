			"info": -1,
			"param": "M",
			"kind": "nonnegative",
			"fortran": "M.LT.0",
			"js": "M < 0"
		},
		{
			"info": -2,
			"param": "N",
			"kind": "expr",
			"fortran": "N.LT.0 .OR. N.GT.M",
			"js": "N < 0 || N > M"
		},
		{
			"info": -3,
			"param": "K",
			"kind": "expr",
			"fortran": "K.LT.0 .OR. K.GT.N",
			"js": "K < 0 || K > N"
		},
		{
			"info": -5,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,M)",
				"js": "max( 1, M )"
			},
			"fortran": "LDA.LT.MAX( 1, M )",
			"js": "lda < max( 1, M )"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.LE.0",
			"js": "N <= 0"
		}
