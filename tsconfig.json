{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": false,
		"noImplicitAny": true,
		"strictFunctionTypes": true,
		"strictBindCallApply": true,
		"noImplicitThis": true,
		"useUnknownInCatchVariables": true,
		"alwaysStrict": true,
		"target": "es2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"types": [],
		"skipLibCheck": true,
		"esModuleInterop": true,
		"paths": {
			"@stdlib/*/lib/index.js": [
				"./node_modules/@stdlib/*/docs/types/index.d.ts"
			],
			"@stdlib/*": [
				"./node_modules/@stdlib/*/docs/types/index.d.ts"
			]
		}
	},
	"include": [
		"types/jsdoc-aliases.d.ts",
		"lib/*/base/*/lib/*.js"
	]
}
