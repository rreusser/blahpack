{
	"routine": "dstev",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DSTEV( JOBZ, N, D, E, Z, LDZ, WORK, INFO )",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "jobz",
			"fortran": "JOBZ",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 2,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "d",
			"fortran": "D",
			"position": 3,
			"role": "vector",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "e",
			"fortran": "E",
			"position": 4,
			"role": "vector",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"N-1"
			],
			"length": {
				"fortran": "N-1",
				"js": "N - 1"
			}
		},
		{
			"name": "Z",
			"fortran": "Z",
			"position": 5,
			"role": "matrix",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"LDZ",
				"N"
			],
			"ld": "LDZ",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldz",
			"fortran": "LDZ",
			"position": 6,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "Z"
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 7,
			"role": "workspace",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"MAX(1,2*N-2)"
			],
			"length": {
				"fortran": "MAX(1,2*N-2)",
				"js": "max( 1, 2 * N - 2 )"
			},
			"minLength": {
				"fortran": "MAX(1,2*N-2)",
				"js": "max( 1, 2 * N - 2 )",
				"source": "dimension"
			}
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 8,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "JOBZ",
			"kind": "enum",
			"fortranValues": "NV",
			"values": [
				"no-vectors",
				"compute-vectors"
			],
			"fortran": ".NOT.( WANTZ .OR. LSAME( JOBZ, 'N' ) )",
			"js": "!(jobz === 'compute-vectors' || jobz === 'no-vectors')"
		},
		{
			"info": -2,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -6,
			"param": "LDZ",
			"kind": "expr",
			"fortran": "LDZ.LT.1 .OR. ( WANTZ .AND. LDZ.LT.N )",
			"js": "ldz < 1 || (jobz === 'compute-vectors' && ldz < N)"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0",
			"js": "N === 0"
		},
		{
			"fortran": "N.EQ.1",
			"js": "N === 1",
			"sets": [
				"IF( WANTZ ) Z( 1, 1 ) = ONE"
			]
		}
	]
}
