{
	"routine": "zggbal",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZGGBAL( JOB, N, A, LDA, B, LDB, ILO, IHI, LSCALE,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "job",
			"fortran": "JOB",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 2,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 3,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDA",
				"N"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 4,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		},
		{
			"name": "B",
			"fortran": "B",
			"position": 5,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDB",
				"N"
			],
			"ld": "LDB",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldb",
			"fortran": "LDB",
			"position": 6,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "B"
		},
		{
			"name": "ilo",
			"fortran": "ILO",
			"position": 7,
			"role": "scalar",
			"dtype": "int32",
			"intent": "out"
		},
		{
			"name": "ihi",
			"fortran": "IHI",
			"position": 8,
			"role": "scalar",
			"dtype": "int32",
			"intent": "out"
		},
		{
			"name": "LSCALE",
			"fortran": "LSCALE",
			"position": 9,
			"role": "vector",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "RSCALE",
			"fortran": "RSCALE",
			"position": 10,
			"role": "vector",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 11,
			"role": "workspace",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"LWORK"
			],
			"minLength": null
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 12,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "JOB",
			"kind": "enum",
			"fortranValues": "BNPS",
			"values": [
				"both",
				"none",
				"permute",
				"scale"
			],
			"fortran": ".NOT.LSAME( JOB, 'N' ) .AND. .NOT.LSAME( JOB, 'P' ) .AND. .NOT.LSAME( JOB, 'S' ) .AND. .NOT.LSAME( JOB, 'B' )",
			"js": "job !== 'none' && job !== 'permute' && job !== 'scale' && job !== 'both'"
		},
		{
			"info": -2,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -4,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDA.LT.MAX( 1, N )",
			"js": "lda < max( 1, N )"
		},
		{
			"info": -6,
			"param": "LDB",
			"kind": "ld",
			"matrix": "B",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDB.LT.MAX( 1, N )",
			"js": "ldb < max( 1, N )"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0",
			"js": "N === 0",
			"sets": [
				"ILO = 1",
				"IHI = N"
			]
		},
		{
			"fortran": "N.EQ.1",
			"js": "N === 1",
			"sets": [
				"ILO = 1",
				"IHI = N",
				"LSCALE( 1 ) = ONE",
				"RSCALE( 1 ) = ONE"
			]
		}
	],
	"notes": [
		"no derivable minimum length for workspace WORK"
	]
}
