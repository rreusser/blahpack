			"info": -3,
			"param": "NRHS",
			"kind": "nonnegative",
			"fortran": "NRHS.LT.0",
			"js": "nrhs < 0"
		},
		{
			"info": -10,
			"param": "LDB",
			"kind": "ld",
			"matrix": "B",
			"min": {
				"fortran": "MAX(N,1)",
				"js": "max( N, 1 )"
			},
			"fortran": "LDB.LT.MAX( N, 1 )",
			"js": "ldb < max( N, 1 )",
			"rowMajor": "ldb < max( 1, nrhs )"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0 .OR. NRHS.EQ.0",
			"js": "N === 0 || nrhs === 0"
		}
	],
	"tuning": [
