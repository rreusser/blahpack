{
	"routine": "zunmtr",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZUNMTR( SIDE, UPLO, TRANS, M, N, A, LDA, TAU, C, LDC,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "side",
			"fortran": "SIDE",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "uplo",
			"fortran": "UPLO",
			"position": 2,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "trans",
			"fortran": "TRANS",
			"position": 3,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "M",
			"fortran": "M",
			"position": 4,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 5,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 6,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"LDA",
				"M"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "NQ",
				"js": "side === 'left' ? M : N"
			},
			"cols": {
				"fortran": "M",
				"js": "side === 'left' ? M : N"
			}
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 7,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		},
		{
			"name": "TAU",
			"fortran": "TAU",
			"position": 8,
			"role": "vector",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"M-1"
			],
			"length": {
				"fortran": "(M-1) if SIDE = 'L' or (N-1) if SIDE = 'R'",
				"js": "( side === 'left' ) ? M - 1 : N - 1"
			}
		},
		{
			"name": "C",
			"fortran": "C",
			"position": 9,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDC",
				"N"
			],
			"ld": "LDC",
			"rows": {
				"fortran": "M",
				"js": "M"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldc",
			"fortran": "LDC",
			"position": 10,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "C"
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 11,
			"role": "workspace",
			"dtype": "complex128",
			"intent": "out",
			"dims": [
				"MAX(1,LWORK)"
			],
			"minLength": {
				"fortran": "NW",
				"js": "side === 'left' ? max( 1, N ) : max( 1, M )",
				"source": "check"
			}
		},
		{
			"name": "lwork",
			"fortran": "LWORK",
			"position": 12,
			"role": "lwork",
			"dtype": "int32",
			"intent": "in",
			"of": "WORK"
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 13,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "SIDE",
			"kind": "enum",
			"fortranValues": "LR",
			"values": [
				"left",
				"right"
			],
			"fortran": ".NOT.LEFT .AND. .NOT.LSAME( SIDE, 'R' )",
			"js": "side !== 'left' && side !== 'right'"
		},
		{
			"info": -2,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.UPPER .AND. .NOT.LSAME( UPLO, 'L' )",
			"js": "uplo !== 'upper' && uplo !== 'lower'"
		},
		{
			"info": -3,
			"param": "TRANS",
			"kind": "enum",
			"fortranValues": "CN",
			"values": [
				"conjugate-transpose",
				"no-transpose"
			],
			"fortran": ".NOT.LSAME( TRANS, 'N' ) .AND. .NOT.LSAME( TRANS, 'C' )",
			"js": "trans !== 'no-transpose' && trans !== 'conjugate-transpose'"
		},
		{
			"info": -4,
			"param": "M",
			"kind": "nonnegative",
			"fortran": "M.LT.0",
			"js": "M < 0"
		},
		{
			"info": -5,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -7,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,NQ)",
				"js": "max( 1, side === 'left' ? M : N )"
			},
			"fortran": "LDA.LT.MAX( 1, NQ )",
			"js": "lda < max( 1, side === 'left' ? M : N )"
		},
		{
			"info": -10,
			"param": "LDC",
			"kind": "ld",
			"matrix": "C",
			"min": {
				"fortran": "MAX(1,M)",
				"js": "max( 1, M )"
			},
			"fortran": "LDC.LT.MAX( 1, M )",
			"js": "ldc < max( 1, M )",
			"rowMajor": "ldc < max( 1, N )"
		}
	],
	"quickReturn": [
		{
			"fortran": "M.EQ.0 .OR. N.EQ.0 .OR. NQ.EQ.1",
			"js": "(M === 0 || N === 0) || (side === 'left' ? M : N) === 1",
			"sets": [
				"WORK( 1 ) = 1"
			]
		}
	],
	"tuning": [
		{
			"fn": "ilaenv",
			"ispec": "1",
			"name": "ZUNMQL",
			"into": "NB"
		},
		{
			"fn": "ilaenv",
			"ispec": "1",
			"name": "ZUNMQR",
			"into": "NB"
		}
	]
}
