			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		},
		{
			"name": "T",
			"fortran": "T",
			"position": 7,
			"role": "matrix",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"LDT",
				"N*NUMBER_OF_ROW_BLOCKS"
			],
			"ld": "LDT",
			"rows": {
				"fortran": "MB",
				"js": "mb"
			},
			"cols": {
				"fortran": "N*NUMBER_OF_ROW_BLOCKS",
				"js": null
			}
		},
		{
			"name": "ldt",
			"fortran": "LDT",
			"position": 8,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "T"
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 9,
			"role": "workspace",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"MAX(1,LWORK)"
			],
			"minLength": {
				"fortran": "M*MB",
				"js": "M * mb",
				"source": "check"
			}
		},
		{
			"name": "lwork",
			"fortran": "LWORK",
			"position": 10,
			"role": "lwork",
			"dtype": "int32",
			"intent": "in",
			"of": "WORK"
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 11,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "M",
			"kind": "nonnegative",
			"fortran": "M.LT.0",
			"js": "M < 0"
		},
		{
			"info": -2,
			"param": "N",
			"kind": "expr",
			"fortran": "N.LT.0 .OR. N.LT.M",
			"js": "N < 0 || N < M"
		},
		{
			"info": -3,
			"param": "MB",
			"kind": "expr",
			"fortran": "MB.LT.1 .OR. ( MB.GT.M .AND. M.GT.0 )",
			"js": "mb < 1 || (mb > M && M > 0)"
		},
		{
			"info": -4,
			"param": "NB",
			"kind": "nonnegative",
			"fortran": "NB.LT.0",
			"js": "nb < 0"
		},
		{
			"info": -6,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
