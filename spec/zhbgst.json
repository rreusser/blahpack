			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldx",
			"fortran": "LDX",
			"position": 11,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "X"
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 12,
			"role": "workspace",
			"dtype": "complex128",
