		},
		{
			"info": 12,
			"param": "LDC",
			"kind": "ld",
			"matrix": "C",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDC.LT.MAX(1,N)",
			"js": "ldc < max( 1, N )"
		}
