			"info": -10,
			"param": "IU",
			"kind": "expr",
			"fortran": "IU.LT.MIN( N, IL ) .OR. IU.GT.N",
			"guard": ".NOT.( VALEIG ) .AND. INDEIG",
			"js": "range !== 'value' && range === 'index' && (iu < min( N, il ) || iu > N)"
		},
