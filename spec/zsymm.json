{
	"routine": "zsymm",
	"package": "blas",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZSYMM(SIDE,UPLO,M,N,ALPHA,A,LDA,B,LDB,BETA,C,LDC)",
	"returns": {
		"kind": "array",
		"param": "C"
	},
	"params": [
		{
			"name": "side",
			"fortran": "SIDE",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "uplo",
			"fortran": "UPLO",
			"position": 2,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "M",
			"fortran": "M",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 4,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "alpha",
			"fortran": "ALPHA",
			"position": 5,
			"role": "scalar",
			"dtype": "complex128",
			"intent": "in"
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 6,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"LDA",
				"KA"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "NROWA",
				"js": "side === 'left' ? M : N"
			},
			"cols": {
				"fortran": "KA",
				"js": "side === 'left' ? M : N"
			}
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 7,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		},
		{
			"name": "B",
			"fortran": "B",
			"position": 8,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"LDB",
				"N"
			],
			"ld": "LDB",
			"rows": {
				"fortran": "M",
				"js": "M"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldb",
			"fortran": "LDB",
			"position": 9,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "B"
		},
		{
			"name": "beta",
			"fortran": "BETA",
			"position": 10,
			"role": "scalar",
			"dtype": "complex128",
			"intent": "in"
		},
		{
			"name": "C",
			"fortran": "C",
			"position": 11,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDC",
				"N"
			],
			"ld": "LDC",
			"rows": {
				"fortran": "M",
				"js": "M"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldc",
			"fortran": "LDC",
			"position": 12,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "C"
		}
	],
	"checks": [
		{
			"info": 1,
			"param": "SIDE",
			"kind": "enum",
			"fortranValues": "LR",
			"values": [
				"left",
				"right"
			],
			"fortran": "(.NOT.LSAME(SIDE,'L')) .AND. (.NOT.LSAME(SIDE,'R'))",
			"js": "side !== 'left' && side !== 'right'"
		},
		{
			"info": 2,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": "(.NOT.UPPER) .AND. (.NOT.LSAME(UPLO,'L'))",
			"js": "uplo !== 'upper' && uplo !== 'lower'"
		},
		{
			"info": 3,
			"param": "M",
			"kind": "nonnegative",
			"fortran": "M.LT.0",
			"js": "M < 0"
		},
		{
			"info": 4,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": 7,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,NROWA)",
				"js": "max( 1, side === 'left' ? M : N )"
			},
			"fortran": "LDA.LT.MAX(1,NROWA)",
			"js": "lda < max( 1, side === 'left' ? M : N )"
		},
		{
			"info": 9,
			"param": "LDB",
			"kind": "ld",
			"matrix": "B",
			"min": {
				"fortran": "MAX(1,M)",
				"js": "max( 1, M )"
			},
			"fortran": "LDB.LT.MAX(1,M)",
			"js": "ldb < max( 1, M )",
			"rowMajor": "ldb < max( 1, N )"
		},
		{
			"info": 12,
			"param": "LDC",
			"kind": "ld",
			"matrix": "C",
			"min": {
				"fortran": "MAX(1,M)",
				"js": "max( 1, M )"
			},
			"fortran": "LDC.LT.MAX(1,M)",
			"js": "ldc < max( 1, M )",
			"rowMajor": "ldc < max( 1, N )"
		}
	],
	"quickReturn": [
		{
			"fortran": "(M.EQ.0) .OR. (N.EQ.0) .OR. ((ALPHA.EQ.ZERO).AND. (BETA.EQ.ONE))",
			"js": "(M === 0 || N === 0) || (real( alpha ) === 0 && imag( alpha ) === 0 && (real( beta ) === 1 && imag( beta ) === 0))"
		}
	],
	"untranslated": [
		"A.cols: unknown identifier KA"
	]
}
