			"kind": "expr",
			"fortran": "LDVSL.LT.1 .OR. ( ILVSL .AND. LDVSL.LT.N )",
			"js": "ldvsl < 1 || ((jobvsl === 'compute-vectors') && ldvsl < N)"
		},
