		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 9,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		}
	],
	"checks": [
		{
			"info": 1,
			"param": "SIDE",
			"kind": "enum",
			"fortranValues": "LR",
			"values": [
				"left",
				"right"
			],
			"fortran": ".NOT.( LSAME( SIDE, 'L' ) .OR. LSAME( SIDE, 'R' ) )",
			"js": "!(side === 'left' || side === 'right')"
		},
		{
			"info": 2,
			"param": "PIVOT",
			"kind": "enum",
			"fortranValues": "BTV",
			"values": null,
			"fortran": ".NOT.( LSAME( PIVOT, 'V' ) .OR. LSAME( PIVOT, 'T' ) .OR. LSAME( PIVOT, 'B' ) )",
			"js": null
		},
		{
			"info": 3,
			"param": "DIRECT",
			"kind": "enum",
			"fortranValues": "BF",
			"values": [
				"backward",
				"forward"
			],
			"fortran": ".NOT.( LSAME( DIRECT, 'F' ) .OR. LSAME( DIRECT, 'B' ) )",
			"js": "!(direct === 'forward' || direct === 'backward')"
		},
		{
			"info": 4,
			"param": "M",
			"kind": "nonnegative",
			"fortran": "M.LT.0",
			"js": "M < 0"
		},
		{
			"info": 5,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": 9,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,M)",
				"js": "max( 1, M )"
			},
			"fortran": "LDA.LT.MAX( 1, M )",
			"js": "lda < max( 1, M )",
			"rowMajor": "lda < max( 1, N )"
		}
	],
	"quickReturn": [
		{
			"fortran": "( M.EQ.0 ) .OR. ( N.EQ.0 )",
			"js": "M === 0 || N === 0"
		}
	],
	"untranslated": [
		"check 2: no canonical value for PIVOT='V'"
	],
	"notes": [
		"option PIVOT accepts 'BTV' but spec/options.json has no canonical value for this family"
	]
}
