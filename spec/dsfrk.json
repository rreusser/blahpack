				"transpose"
			],
			"fortran": ".NOT.NORMALTRANSR .AND. .NOT.LSAME( TRANSR, 'T' )",
			"js": "transr !== 'no-transpose' && transr !== 'transpose'"
		},
		{
			"info": -2,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.LOWER .AND. .NOT.LSAME( UPLO, 'U' )",
			"js": "uplo !== 'lower' && uplo !== 'upper'"
		},
		{
			"info": -3,
			"param": "TRANS",
			"kind": "enum",
			"fortranValues": "NT",
			"values": [
				"no-transpose",
				"transpose"
			],
			"fortran": ".NOT.NOTRANS .AND. .NOT.LSAME( TRANS, 'T' )",
			"js": "trans !== 'no-transpose' && trans !== 'transpose'"
		},
		{
			"info": -4,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
