				"right"
			],
			"fortran": ".NOT.LEFT .AND. .NOT.RIGHT",
			"js": "side !== 'left' && side !== 'right'"
		},
		{
			"info": -2,
			"param": "TRANS",
			"kind": "enum",
			"fortranValues": "CN",
			"values": [
				"conjugate-transpose",
				"no-transpose"
			],
			"fortran": ".NOT.TRAN .AND. .NOT.NOTRAN",
			"js": "trans !== 'conjugate-transpose' && trans !== 'no-transpose'"
		},
		{
			"info": -3,
			"param": "M",
			"kind": "nonnegative",
			"fortran": "M.LT.0",
			"js": "M < 0"
