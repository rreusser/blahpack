{
	"routine": "dtptri",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DTPTRI( UPLO, DIAG, N, AP, INFO )",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "uplo",
			"fortran": "UPLO",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "diag",
			"fortran": "DIAG",
			"position": 2,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "AP",
			"fortran": "AP",
			"position": 4,
			"role": "packed",
			"format": "packed",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"N*(N+1)/2"
			],
			"length": {
				"fortran": "N*(N+1)/2",
				"js": "trunc( N * (N + 1) / 2 )"
			}
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 5,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.UPPER .AND. .NOT.LSAME( UPLO, 'L' )",
			"js": "uplo !== 'upper' && uplo !== 'lower'"
		},
		{
			"info": -2,
			"param": "DIAG",
			"kind": "enum",
			"fortranValues": "NU",
			"values": [
				"non-unit",
				"unit"
			],
			"fortran": ".NOT.NOUNIT .AND. .NOT.LSAME( DIAG, 'U' )",
			"js": "diag !== 'non-unit' && diag !== 'unit'"
		},
		{
			"info": -3,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		}
	],
	"quickReturn": []
}
