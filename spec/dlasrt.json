{
	"routine": "dlasrt",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DLASRT( ID, N, D, INFO )",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "id",
			"fortran": "ID",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 2,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "d",
			"fortran": "D",
			"position": 3,
			"role": "vector",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 4,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "ID",
			"kind": "enum",
			"fortranValues": "DI",
			"values": [
				"decreasing",
				"increasing"
			],
			"fortran": "DIR.EQ.-1",
			"js": "(id === 'decreasing' ? 0 : (id === 'increasing' ? 1 : -1)) === -1"
		},
		{
			"info": -2,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.LE.1",
			"js": "N <= 1"
		}
	]
}
