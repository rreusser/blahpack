{
	"routine": "dormql",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DORMQL( SIDE, TRANS, M, N, K, A, LDA, TAU, C, LDC,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "side",
			"fortran": "SIDE",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "trans",
			"fortran": "TRANS",
			"position": 2,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "M",
			"fortran": "M",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 4,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "K",
			"fortran": "K",
			"position": 5,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 6,
			"role": "matrix",
			"dtype": "float64",
			"intent": "in",
			"dims": [
				"LDA",
				"K"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "NQ",
				"js": "side === 'left' ? M : N"
			},
			"cols": {
				"fortran": "K",
				"js": "K"
			}
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 7,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		},
		{
			"name": "TAU",
			"fortran": "TAU",
			"position": 8,
			"role": "vector",
			"dtype": "float64",
			"intent": "in",
			"dims": [
				"K"
			],
			"length": {
				"fortran": "K",
				"js": "K"
			}
		},
		{
			"name": "C",
			"fortran": "C",
			"position": 9,
			"role": "matrix",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDC",
				"N"
			],
			"ld": "LDC",
			"rows": {
				"fortran": "M",
				"js": "M"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldc",
			"fortran": "LDC",
			"position": 10,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "C"
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 11,
			"role": "workspace",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"MAX(1,LWORK)"
			],
			"minLength": {
				"fortran": "NW",
				"js": "side === 'left' ? max( 1, N ) : max( 1, M )",
				"source": "check"
			},
			"adaptive": true
		},
		{
			"name": "lwork",
			"fortran": "LWORK",
			"position": 12,
			"role": "lwork",
			"dtype": "int32",
			"intent": "in",
			"of": "WORK"
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 13,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "SIDE",
			"kind": "enum",
			"fortranValues": "LR",
			"values": [
				"left",
				"right"
			],
			"fortran": ".NOT.LEFT .AND. .NOT.LSAME( SIDE, 'R' )",
			"js": "side !== 'left' && side !== 'right'"
		},
		{
			"info": -2,
			"param": "TRANS",
			"kind": "enum",
			"fortranValues": "NT",
			"values": [
				"no-transpose",
				"transpose"
			],
			"fortran": ".NOT.NOTRAN .AND. .NOT.LSAME( TRANS, 'T' )",
			"js": "trans !== 'no-transpose' && trans !== 'transpose'"
		},
		{
			"info": -3,
			"param": "M",
			"kind": "nonnegative",
			"fortran": "M.LT.0",
			"js": "M < 0"
		},
		{
			"info": -4,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -5,
			"param": "K",
			"kind": "expr",
			"fortran": "K.LT.0 .OR. K.GT.NQ",
			"js": "K < 0 || K > (side === 'left' ? M : N)"
		},
		{
			"info": -7,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,NQ)",
				"js": "max( 1, side === 'left' ? M : N )"
			},
			"fortran": "LDA.LT.MAX( 1, NQ )",
			"js": "lda < max( 1, side === 'left' ? M : N )",
			"rowMajor": "lda < max( 1, K )"
		},
		{
			"info": -10,
			"param": "LDC",
			"kind": "ld",
			"matrix": "C",
			"min": {
				"fortran": "MAX(1,M)",
				"js": "max( 1, M )"
			},
			"fortran": "LDC.LT.MAX( 1, M )",
			"js": "ldc < max( 1, M )",
			"rowMajor": "ldc < max( 1, N )"
		}
	],
	"quickReturn": [
		{
			"fortran": "M.EQ.0 .OR. N.EQ.0",
			"js": "M === 0 || N === 0"
		}
	]
}
