{
	"routine": "dtrexc",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DTREXC( COMPQ, N, T, LDT, Q, LDQ, IFST, ILST, WORK,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "compq",
			"fortran": "COMPQ",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 2,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "T",
			"fortran": "T",
			"position": 3,
			"role": "matrix",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDT",
				"N"
			],
			"ld": "LDT",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldt",
			"fortran": "LDT",
			"position": 4,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "T"
		},
		{
			"name": "Q",
			"fortran": "Q",
			"position": 5,
			"role": "matrix",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDQ",
				"N"
			],
			"ld": "LDQ",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldq",
			"fortran": "LDQ",
			"position": 6,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "Q"
		},
		{
			"name": "ifst",
			"fortran": "IFST",
			"position": 7,
			"role": "scalar",
			"dtype": "int32",
			"intent": "inout"
		},
		{
			"name": "ilst",
			"fortran": "ILST",
			"position": 8,
			"role": "scalar",
			"dtype": "int32",
			"intent": "inout"
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 9,
			"role": "workspace",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			},
			"minLength": {
				"fortran": "N",
				"js": "N",
				"source": "dimension"
			}
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 10,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "COMPQ",
			"kind": "enum",
			"fortranValues": "NV",
			"values": [
				"none",
				"update"
			],
			"fortran": ".NOT.WANTQ .AND. .NOT.LSAME( COMPQ, 'N' )",
			"js": "compq !== 'update' && compq !== 'none'"
		},
		{
			"info": -2,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -4,
			"param": "LDT",
			"kind": "ld",
			"matrix": "T",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDT.LT.MAX( 1, N )",
			"js": "ldt < max( 1, N )"
		},
		{
			"info": -6,
			"param": "LDQ",
			"kind": "expr",
			"fortran": "LDQ.LT.1 .OR. ( WANTQ .AND. LDQ.LT.MAX( 1, N ) )",
			"js": "ldq < 1 || (compq === 'update' && ldq < max( 1, N ))"
		},
		{
			"info": -7,
			"param": "IFST",
			"kind": "expr",
			"fortran": "( IFST.LT.1 .OR. IFST.GT.N ).AND.( N.GT.0 )",
			"js": "(ifst < 1 || ifst > N) && N > 0"
		},
		{
			"info": -8,
			"param": "ILST",
			"kind": "expr",
			"fortran": "( ILST.LT.1 .OR. ILST.GT.N ).AND.( N.GT.0 )",
			"js": "(ilst < 1 || ilst > N) && N > 0"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.LE.1",
			"js": "N <= 1"
		}
	]
}
