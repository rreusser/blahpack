{
	"routine": "zpftrf",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZPFTRF( TRANSR, UPLO, N, A, INFO )",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "transr",
			"fortran": "TRANSR",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "uplo",
			"fortran": "UPLO",
			"position": 2,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 4,
			"role": "packed",
			"format": "rfp",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"N*(N+1)/2"
			],
			"length": {
				"fortran": "N*(N+1)/2",
				"js": "trunc( N * (N + 1) / 2 )"
			}
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 5,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "TRANSR",
			"kind": "enum",
			"fortranValues": "CN",
			"values": [
				"conjugate-transpose",
				"no-transpose"
			],
			"fortran": ".NOT.NORMALTRANSR .AND. .NOT.LSAME( TRANSR, 'C' )",
			"js": "transr !== 'no-transpose' && transr !== 'conjugate-transpose'"
		},
		{
			"info": -2,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.LOWER .AND. .NOT.LSAME( UPLO, 'U' )",
			"js": "uplo !== 'lower' && uplo !== 'upper'"
		},
		{
			"info": -3,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0",
			"js": "N === 0"
		}
	]
}
