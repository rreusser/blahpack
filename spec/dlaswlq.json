{
	"routine": "dlaswlq",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DLASWLQ( M, N, MB, NB, A, LDA, T, LDT, WORK,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "M",
			"fortran": "M",
