			"param": "M",
			"kind": "nonnegative",
			"fortran": "M.LT.0",
			"js": "M < 0"
		},
		{
			"info": -2,
			"param": "N",
			"kind": "expr",
			"fortran": "N.LT.0 .OR. M.LT.N",
			"js": "N < 0 || M < N"
		},
		{
			"info": -3,
			"param": "MB1",
			"kind": "expr",
			"fortran": "MB1.LE.N",
			"js": "mb1 <= N"
