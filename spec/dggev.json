{
	"routine": "dggev",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DGGEV( JOBVL, JOBVR, N, A, LDA, B, LDB, ALPHAR, ALPHAI,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "jobvl",
			"fortran": "JOBVL",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "jobvr",
			"fortran": "JOBVR",
			"position": 2,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 4,
			"role": "matrix",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDA",
				"N"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			},
			"workDependent": "the generalized Schur form S is unique only up to signs, which the LWORK-dependent QR blocking can change"
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 5,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		},
		{
			"name": "B",
			"fortran": "B",
			"position": 6,
			"role": "matrix",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDB",
				"N"
			],
			"ld": "LDB",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			},
			"workDependent": "the triangular T is unique only up to signs, which the LWORK-dependent QR blocking can change"
		},
		{
			"name": "ldb",
			"fortran": "LDB",
			"position": 7,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "B"
		},
		{
			"name": "ALPHAR",
			"fortran": "ALPHAR",
			"position": 8,
			"role": "vector",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ALPHAI",
			"fortran": "ALPHAI",
			"position": 9,
			"role": "vector",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "BETA",
			"fortran": "BETA",
			"position": 10,
			"role": "vector",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "VL",
			"fortran": "VL",
			"position": 11,
			"role": "matrix",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"LDVL",
				"N"
			],
			"ld": "LDVL",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			},
			"workDependent": "each left eigenvector is unique only up to a scalar factor of unit size, which the LWORK-dependent QR blocking can change"
		},
		{
			"name": "ldvl",
			"fortran": "LDVL",
			"position": 12,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "VL"
		},
		{
			"name": "VR",
			"fortran": "VR",
			"position": 13,
			"role": "matrix",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"LDVR",
				"N"
			],
			"ld": "LDVR",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			},
			"workDependent": "each right eigenvector is unique only up to a scalar factor of unit size, which the LWORK-dependent QR blocking can change"
		},
		{
			"name": "ldvr",
			"fortran": "LDVR",
			"position": 14,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "VR"
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 15,
			"role": "workspace",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"MAX(1,LWORK)"
			],
			"minLength": {
				"fortran": "MINWRK",
				"js": "max( 1, 8 * N )",
				"source": "check"
			}
		},
		{
			"name": "lwork",
			"fortran": "LWORK",
			"position": 16,
			"role": "lwork",
			"dtype": "int32",
			"intent": "in",
			"of": "WORK"
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 17,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "JOBVL",
			"kind": "enum",
			"fortranValues": "NV",
			"values": [
				"no-vectors",
				"compute-vectors"
			],
			"fortran": "IJOBVL.LE.0",
			"js": "(jobvl === 'no-vectors' ? 1 : (jobvl === 'compute-vectors' ? 2 : -1)) <= 0"
		},
		{
			"info": -2,
			"param": "JOBVR",
			"kind": "enum",
			"fortranValues": "NV",
			"values": [
				"no-vectors",
				"compute-vectors"
			],
			"fortran": "IJOBVR.LE.0",
			"js": "(jobvr === 'no-vectors' ? 1 : (jobvr === 'compute-vectors' ? 2 : -1)) <= 0"
		},
		{
			"info": -3,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -5,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDA.LT.MAX( 1, N )",
			"js": "lda < max( 1, N )"
		},
		{
			"info": -7,
			"param": "LDB",
			"kind": "ld",
			"matrix": "B",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDB.LT.MAX( 1, N )",
			"js": "ldb < max( 1, N )"
		},
		{
			"info": -12,
			"param": "LDVL",
			"kind": "expr",
			"fortran": "LDVL.LT.1 .OR. ( ILVL .AND. LDVL.LT.N )",
			"js": "ldvl < 1 || ((jobvl === 'compute-vectors') && ldvl < N)"
		},
		{
			"info": -14,
			"param": "LDVR",
			"kind": "expr",
			"fortran": "LDVR.LT.1 .OR. ( ILVR .AND. LDVR.LT.N )",
			"js": "ldvr < 1 || ((jobvr === 'compute-vectors') && ldvr < N)"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0",
			"js": "N === 0"
		}
	],
	"tuning": [
		{
			"fn": "ilaenv",
			"ispec": "1",
			"name": "DGEQRF",
			"into": "MAXWRK"
		},
		{
			"fn": "ilaenv",
			"ispec": "1",
			"name": "DORMQR",
			"into": "MAXWRK"
		},
		{
			"fn": "ilaenv",
			"ispec": "1",
			"name": "DORGQR",
			"into": "MAXWRK"
		}
	],
	"overrides": [
		{
			"reason": "DGGEV hands its LWORK to DGEQRF, DORMQR and DORGQR, which pick their block size from LWORK and fall back to unblocked code when it is short of the optimum. The blocked and unblocked QR steps round differently, and the QZ iteration that follows can then reach a generalized Schur form (S,T) whose rows and columns differ by signs, with eigenvectors scaled by -1 (real) or by a different complex unit (complex pairs). ALPHAR, ALPHAI and BETA do not depend on LWORK beyond rounding; the module's tests check the eigenvalues at the minimum WORK past the blocking threshold (ticket 0100).",
			"set": {
				"params.A.workDependent": "the generalized Schur form S is unique only up to signs, which the LWORK-dependent QR blocking can change",
				"params.B.workDependent": "the triangular T is unique only up to signs, which the LWORK-dependent QR blocking can change",
				"params.VL.workDependent": "each left eigenvector is unique only up to a scalar factor of unit size, which the LWORK-dependent QR blocking can change",
				"params.VR.workDependent": "each right eigenvector is unique only up to a scalar factor of unit size, which the LWORK-dependent QR blocking can change"
			}
		}
	]
}
