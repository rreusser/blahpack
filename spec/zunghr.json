{
	"routine": "zunghr",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZUNGHR( N, ILO, IHI, A, LDA, TAU, WORK, LWORK, INFO )",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "N",
			"fortran": "N",
			"position": 1,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "ilo",
			"fortran": "ILO",
			"position": 2,
			"role": "scalar",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "ihi",
			"fortran": "IHI",
			"position": 3,
			"role": "scalar",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 4,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDA",
				"N"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 5,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		},
		{
			"name": "TAU",
			"fortran": "TAU",
			"position": 6,
			"role": "vector",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"N-1"
			],
			"length": {
				"fortran": "N-1",
				"js": "N - 1"
			}
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 7,
			"role": "workspace",
			"dtype": "complex128",
			"intent": "out",
			"dims": [
				"MAX(1,LWORK)"
			],
			"minLength": {
				"fortran": "MAX(1,NH)",
				"js": "max( 1, ihi - ilo )",
				"source": "check"
			}
		},
		{
			"name": "lwork",
			"fortran": "LWORK",
			"position": 8,
			"role": "lwork",
			"dtype": "int32",
			"intent": "in",
			"of": "WORK"
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 9,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -2,
			"param": "ILO",
			"kind": "expr",
			"fortran": "ILO.LT.1 .OR. ILO.GT.MAX( 1, N )",
			"js": "ilo < 1 || ilo > max( 1, N )"
		},
		{
			"info": -3,
			"param": "IHI",
			"kind": "expr",
			"fortran": "IHI.LT.MIN( ILO, N ) .OR. IHI.GT.N",
			"js": "ihi < min( ilo, N ) || ihi > N"
		},
		{
			"info": -5,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDA.LT.MAX( 1, N )",
			"js": "lda < max( 1, N )"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0",
			"js": "N === 0",
			"sets": [
				"WORK( 1 ) = 1"
			]
		}
	]
}
