{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": false,
		"noImplicitAny": false,
		"target": "es2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"types": [],
		"skipLibCheck": true
	},
	"include": [
		"types/jsdoc-aliases.d.ts",
		"lib/*/base/*/lib/*.js"
	]
}
