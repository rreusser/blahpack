			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "M",
			"fortran": "M",
			"position": 4,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 5,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "c",
			"fortran": "C",
			"position": 6,
			"role": "vector",
			"dtype": "float64",
			"intent": "in",
			"dims": [
				"M-1"
			],
			"length": {
				"fortran": "M-1",
				"js": "M - 1"
			}
		},
		{
			"name": "s",
			"fortran": "S",
			"position": 7,
			"role": "vector",
			"dtype": "float64",
			"intent": "in",
			"dims": [
				"M-1"
			],
			"length": {
				"fortran": "M-1",
				"js": "M - 1"
			}
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 8,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDA",
				"N"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "M",
				"js": "M"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
