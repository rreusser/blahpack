		{
			"info": -1,
			"param": "BALANC",
			"kind": "enum",
			"fortranValues": "BNPS",
			"values": [
				"both",
				"none",
				"permute",
				"scale"
			],
			"fortran": ".NOT.( LSAME( BALANC, 'N' ) .OR. LSAME( BALANC, 'S' ) .OR. LSAME( BALANC, 'P' ) .OR. LSAME( BALANC, 'B' ) )",
			"js": "!(((balanc === 'none' || balanc === 'scale') || balanc === 'permute') || balanc === 'both')"
		},
		{
			"info": -2,
			"param": "JOBVL",
			"kind": "enum",
			"fortranValues": "NV",
			"values": [
				"no-vectors",
				"compute-vectors"
			],
			"fortran": "( .NOT.WANTVL ) .AND. ( .NOT.LSAME( JOBVL, 'N' ) )",
			"js": "jobvl !== 'compute-vectors' && jobvl !== 'no-vectors'"
		},
		{
			"info": -3,
			"param": "JOBVR",
			"kind": "enum",
			"fortranValues": "NV",
			"values": [
