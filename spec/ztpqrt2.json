				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 5,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		},
		{
			"name": "B",
			"fortran": "B",
			"position": 6,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDB",
				"N"
			],
			"ld": "LDB",
			"rows": {
				"fortran": "M",
				"js": "M"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldb",
			"fortran": "LDB",
			"position": 7,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "B"
		},
		{
			"name": "T",
			"fortran": "T",
			"position": 8,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "out",
			"dims": [
