{
	"routine": "dlasq3",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DLASQ3( I0, N0, Z, PP, DMIN, SIGMA, DESIG, QMAX, NFAIL,",
	"returns": {
		"kind": "array",
		"param": "z"
	},
	"params": [
		{
			"name": "i0",
			"fortran": "I0",
			"position": 1,
			"role": "scalar",
			"dtype": "int32",
			"intent": "in",
			"reference": "First index."
		},
		{
			"name": "n0",
			"fortran": "N0",
			"position": 2,
			"role": "scalar",
			"dtype": "int32",
			"intent": "inout",
			"reference": "Last index."
		},
		{
			"name": "z",
			"fortran": "Z",
			"position": 3,
			"role": "vector",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"4*N0"
			],
			"length": {
				"fortran": "4*N0",
				"js": "4 * n0"
			},
			"reference": "Z holds the qd array."
		},
		{
			"name": "pp",
			"fortran": "PP",
			"position": 4,
			"role": "scalar",
			"dtype": "int32",
			"intent": "inout",
			"reference": "`PP=0` for ping, `PP=1` for pong. `PP=2` indicates that flipping was applied to the Z array and that the initial tests for deflation should not be performed."
		},
		{
			"name": "dmin",
			"fortran": "DMIN",
			"position": 5,
			"role": "scalar",
			"dtype": "float64",
			"intent": "out",
			"reference": "Minimum value of d."
		},
		{
			"name": "sigma",
			"fortran": "SIGMA",
			"position": 6,
			"role": "scalar",
			"dtype": "float64",
			"intent": "out",
			"reference": "Sum of shifts used in current segment."
		},
		{
			"name": "desig",
			"fortran": "DESIG",
			"position": 7,
			"role": "scalar",
			"dtype": "float64",
			"intent": "inout",
			"reference": "Lower order part of `SIGMA`"
		},
		{
			"name": "qmax",
			"fortran": "QMAX",
			"position": 8,
			"role": "scalar",
			"dtype": "float64",
			"intent": "inout",
			"reference": "Maximum value of q."
		},
		{
			"name": "nfail",
			"fortran": "NFAIL",
			"position": 9,
			"role": "scalar",
			"dtype": "int32",
			"intent": "inout",
			"reference": "Increment `NFAIL` by 1 each time the shift was too big."
		},
		{
			"name": "iter",
			"fortran": "ITER",
			"position": 10,
			"role": "scalar",
			"dtype": "int32",
			"intent": "inout",
			"reference": "Increment `ITER` by 1 for each iteration."
		},
		{
			"name": "ndiv",
			"fortran": "NDIV",
			"position": 11,
			"role": "scalar",
			"dtype": "int32",
			"intent": "inout",
			"reference": "Increment `NDIV` by 1 for each division."
		},
		{
			"name": "ieee",
			"fortran": "IEEE",
			"position": 12,
			"role": "scalar",
			"dtype": "bool",
			"intent": "in",
			"reference": "Flag for `IEEE` or non `IEEE` arithmetic (passed to DLASQ5)."
		},
		{
			"name": "ttype",
			"fortran": "TTYPE",
			"position": 13,
			"role": "scalar",
			"dtype": "int32",
			"intent": "inout",
			"reference": "Shift type."
		},
		{
			"name": "dmin1",
			"fortran": "DMIN1",
			"position": 14,
			"role": "scalar",
			"dtype": "float64",
			"intent": "inout"
		},
		{
			"name": "dmin2",
			"fortran": "DMIN2",
			"position": 15,
			"role": "scalar",
			"dtype": "float64",
			"intent": "inout"
		},
		{
			"name": "dn",
			"fortran": "DN",
			"position": 16,
			"role": "scalar",
			"dtype": "float64",
			"intent": "inout"
		},
		{
			"name": "dn1",
			"fortran": "DN1",
			"position": 17,
			"role": "scalar",
			"dtype": "float64",
			"intent": "inout"
		},
		{
			"name": "dn2",
			"fortran": "DN2",
			"position": 18,
			"role": "scalar",
			"dtype": "float64",
			"intent": "inout"
		},
		{
			"name": "g",
			"fortran": "G",
			"position": 19,
			"role": "scalar",
			"dtype": "float64",
			"intent": "inout"
		},
		{
			"name": "tau",
			"fortran": "TAU",
			"position": 20,
			"role": "scalar",
			"dtype": "float64",
			"intent": "inout",
			"reference": "These are passed as arguments in order to save their values between calls to DLASQ3."
		}
	],
	"checks": [],
	"quickReturn": [],
	"overrides": [
		{
			"reason": "DLASQ3 documents QMAX as [in] but assigns it (dlasq3.f:317, QMAX = MAX( QMAX, Z( 4*I0+PP-3 ), Z( 4*I0+PP+1 ) )), so it is in/out.",
			"set": {
				"params.QMAX.intent": "inout"
			}
		}
	]
}
