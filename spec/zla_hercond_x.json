{
	"routine": "zla_hercond_x",
	"package": "lapack",
	"kind": "function",
	"signature": "DOUBLE PRECISION FUNCTION ZLA_HERCOND_X( UPLO, N, A, LDA, AF,",
	"returns": {
		"kind": "value",
		"dtype": "float64"
	},
	"params": [
		{
			"name": "uplo",
			"fortran": "UPLO",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in",
			"reference": "-   `= 'U'`: Upper triangle of A is stored;\n-   `= 'L'`: Lower triangle of A is stored."
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 2,
			"role": "dim",
			"dtype": "int32",
			"intent": "in",
			"reference": "The number of linear equations, i.e., the order of the matrix A. $N \\ge 0$."
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 3,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"LDA",
				"N"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			},
			"reference": "On entry, the N-by-N matrix A."
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 4,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A",
			"reference": "The leading dimension of the array A. $\\mathrm{LDA} \\ge \\max (1,N)$."
		},
		{
			"name": "AF",
			"fortran": "AF",
			"position": 5,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"LDAF",
				"N"
			],
			"ld": "LDAF",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			},
			"reference": "The block diagonal matrix D and the multipliers used to obtain the factor U or L as computed by ZHETRF."
		},
		{
			"name": "ldaf",
			"fortran": "LDAF",
			"position": 6,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "AF",
			"reference": "The leading dimension of the array `AF`. $\\mathrm{LDAF} \\ge \\max (1,N)$."
		},
		{
			"name": "IPIV",
			"fortran": "IPIV",
			"position": 7,
			"role": "index",
			"dtype": "int32",
			"intent": "in",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			},
			"reference": "Details of the interchanges and the block structure of D as determined by CHETRF."
		},
		{
			"name": "x",
			"fortran": "X",
			"position": 8,
			"role": "vector",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			},
			"reference": "The vector X in the formula $\\operatorname{op}(A) \\, \\operatorname{diag}(X)$."
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 9,
			"role": "info",
			"dtype": "int32",
			"intent": "out",
			"reference": "-   `= 0`: Successful exit. $i > 0$:  The ith argument is invalid."
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 10,
			"role": "workspace",
			"dtype": "complex128",
			"intent": "out",
			"dims": [
				"2*N"
			],
			"length": {
				"fortran": "2*N",
				"js": "2 * N"
			},
			"minLength": {
				"fortran": "2*N",
				"js": "2 * N",
				"source": "dimension"
			},
			"reference": "Workspace."
		},
		{
			"name": "RWORK",
			"fortran": "RWORK",
			"position": 11,
			"role": "workspace",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			},
			"minLength": {
				"fortran": "N",
				"js": "N",
				"source": "dimension"
			},
			"reference": "Workspace."
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.UPPER .AND. .NOT.LSAME( UPLO, 'L' )",
			"js": "uplo !== 'upper' && uplo !== 'lower'"
		},
		{
			"info": -2,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -4,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDA.LT.MAX( 1, N )",
			"js": "lda < max( 1, N )"
		},
		{
			"info": -6,
			"param": "LDAF",
			"kind": "ld",
			"matrix": "AF",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDAF.LT.MAX( 1, N )",
			"js": "ldaf < max( 1, N )"
		}
	],
	"quickReturn": []
}
