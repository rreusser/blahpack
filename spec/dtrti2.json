{
	"routine": "dtrti2",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DTRTI2( UPLO, DIAG, N, A, LDA, INFO )",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "uplo",
			"fortran": "UPLO",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "diag",
			"fortran": "DIAG",
			"position": 2,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 4,
			"role": "matrix",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDA",
				"N"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 5,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 6,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.UPPER .AND. .NOT.LSAME( UPLO, 'L' )",
			"js": "uplo !== 'upper' && uplo !== 'lower'"
		},
		{
			"info": -2,
			"param": "DIAG",
			"kind": "enum",
			"fortranValues": "NU",
			"values": [
				"non-unit",
				"unit"
			],
			"fortran": ".NOT.NOUNIT .AND. .NOT.LSAME( DIAG, 'U' )",
			"js": "diag !== 'non-unit' && diag !== 'unit'"
		},
		{
			"info": -3,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -5,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDA.LT.MAX( 1, N )",
			"js": "lda < max( 1, N )"
		}
	],
	"quickReturn": []
}
