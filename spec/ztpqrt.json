			"info": -4,
			"param": "NB",
			"kind": "expr",
			"fortran": "NB.LT.1 .OR. (NB.GT.N .AND. N.GT.0)",
			"js": "nb < 1 || (nb > N && N > 0)"
		},
		{
			"info": -6,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
