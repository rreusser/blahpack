{
	"routine": "zsytrs_3",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZSYTRS_3( UPLO, N, NRHS, A, LDA, E, IPIV, B, LDB,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "uplo",
			"fortran": "UPLO",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 2,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "nrhs",
			"fortran": "NRHS",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 4,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"LDA",
				"N"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 5,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		},
		{
			"name": "e",
			"fortran": "E",
			"position": 6,
			"role": "vector",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "IPIV",
			"fortran": "IPIV",
			"position": 7,
			"role": "index",
			"dtype": "int32",
			"intent": "in",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "B",
			"fortran": "B",
			"position": 8,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDB",
				"NRHS"
			],
			"ld": "LDB",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "NRHS",
				"js": "nrhs"
			}
		},
		{
			"name": "ldb",
			"fortran": "LDB",
			"position": 9,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "B"
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 10,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.UPPER .AND. .NOT.LSAME( UPLO, 'L' )",
			"js": "uplo !== 'upper' && uplo !== 'lower'"
		},
		{
			"info": -2,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -3,
			"param": "NRHS",
			"kind": "nonnegative",
			"fortran": "NRHS.LT.0",
			"js": "nrhs < 0"
		},
		{
			"info": -5,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDA.LT.MAX( 1, N )",
			"js": "lda < max( 1, N )"
		},
		{
			"info": -9,
			"param": "LDB",
			"kind": "ld",
			"matrix": "B",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDB.LT.MAX( 1, N )",
			"js": "ldb < max( 1, N )",
			"rowMajor": "ldb < max( 1, nrhs )"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0 .OR. NRHS.EQ.0",
			"js": "N === 0 || nrhs === 0"
		}
	]
}
