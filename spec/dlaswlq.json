				"js": "max( 1, M )"
			},
			"fortran": "LDA.LT.MAX( 1, M )",
			"js": "lda < max( 1, M )",
			"rowMajor": "lda < max( 1, N )"
		},
		{
			"info": -8,
			"param": "LDT",
			"kind": "ld",
			"matrix": "T",
			"min": {
				"fortran": "MB",
				"js": "mb"
			},
			"fortran": "LDT.LT.MB",
			"js": "ldt < mb",
			"rowMajor": null
		}
	],
	"quickReturn": [
		{
			"fortran": "MIN(M,N).EQ.0",
			"js": "min( M, N ) === 0"
		},
		{
			"fortran": "(M.GE.N).OR.(NB.LE.M).OR.(NB.GE.N)",
			"js": "(M >= N || nb <= M) || nb >= N",
			"sets": [
				"CALL DGELQT( M, N, MB, A, LDA, T, LDT, WORK, INFO)"
			]
		}
	],
	"untranslated": [
		"T.cols: unknown identifier NUMBER_OF_ROW_BLOCKS",
		"check -8.rowMajor: the column count of T is not established"
	]
