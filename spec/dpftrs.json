{
	"routine": "dpftrs",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DPFTRS( TRANSR, UPLO, N, NRHS, A, B, LDB, INFO )",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "transr",
			"fortran": "TRANSR",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "uplo",
			"fortran": "UPLO",
			"position": 2,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "nrhs",
			"fortran": "NRHS",
			"position": 4,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 5,
			"role": "packed",
			"format": "rfp",
			"dtype": "float64",
			"intent": "in",
			"dims": [
				"N*(N+1)/2"
			],
			"length": {
				"fortran": "N*(N+1)/2",
				"js": "trunc( N * (N + 1) / 2 )"
			}
		},
		{
			"name": "B",
			"fortran": "B",
			"position": 6,
			"role": "matrix",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDB",
				"NRHS"
			],
			"ld": "LDB",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "NRHS",
				"js": "nrhs"
			}
		},
		{
			"name": "ldb",
			"fortran": "LDB",
			"position": 7,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "B"
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 8,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "TRANSR",
			"kind": "enum",
			"fortranValues": "NT",
			"values": [
				"no-transpose",
				"transpose"
			],
			"fortran": ".NOT.NORMALTRANSR .AND. .NOT.LSAME( TRANSR, 'T' )",
			"js": "transr !== 'no-transpose' && transr !== 'transpose'"
		},
		{
			"info": -2,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.LOWER .AND. .NOT.LSAME( UPLO, 'U' )",
			"js": "uplo !== 'lower' && uplo !== 'upper'"
		},
		{
			"info": -3,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -4,
			"param": "NRHS",
			"kind": "nonnegative",
			"fortran": "NRHS.LT.0",
			"js": "nrhs < 0"
		},
		{
			"info": -7,
			"param": "LDB",
			"kind": "ld",
			"matrix": "B",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDB.LT.MAX( 1, N )",
			"js": "ldb < max( 1, N )",
			"rowMajor": "ldb < max( 1, nrhs )"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0 .OR. NRHS.EQ.0",
			"js": "N === 0 || nrhs === 0"
		}
	]
}
