			}
		},
		{
			"name": "Z",
			"fortran": "Z",
			"position": 13,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "out",
			"dims": [
				"LDZ",
				"MAX(1,M)"
			],
			"ld": "LDZ",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "MAX(1,M)",
				"js": "max( 1, m )"
			}
		},
		{
			"name": "ldz",
			"fortran": "LDZ",
			"position": 14,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "Z"
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 15,
			"role": "workspace",
			"dtype": "complex128",
			"intent": "out",
			"dims": [
				"2*N"
			],
			"length": {
				"fortran": "2*N",
				"js": "2 * N"
			},
			"minLength": {
				"fortran": "2*N",
