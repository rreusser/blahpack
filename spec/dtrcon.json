{
	"routine": "dtrcon",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DTRCON( NORM, UPLO, DIAG, N, A, LDA, RCOND, WORK,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "norm",
			"fortran": "NORM",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "uplo",
			"fortran": "UPLO",
			"position": 2,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "diag",
			"fortran": "DIAG",
			"position": 3,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 4,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 5,
			"role": "matrix",
			"dtype": "float64",
			"intent": "in",
			"dims": [
				"LDA",
				"N"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 6,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		},
		{
			"name": "rcond",
			"fortran": "RCOND",
			"position": 7,
			"role": "scalar",
			"dtype": "float64",
			"intent": "out"
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 8,
			"role": "workspace",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"3*N"
			],
			"length": {
				"fortran": "3*N",
				"js": "3 * N"
			},
			"minLength": {
				"fortran": "3*N",
				"js": "3 * N",
				"source": "dimension"
			}
		},
		{
			"name": "IWORK",
			"fortran": "IWORK",
			"position": 9,
			"role": "workspace",
			"dtype": "int32",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			},
			"minLength": {
				"fortran": "N",
				"js": "N",
				"source": "dimension"
			}
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 10,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "NORM",
			"kind": "enum",
			"fortranValues": "IO1",
			"values": [
				"inf-norm",
				"one-norm"
			],
			"fortran": ".NOT.ONENRM .AND. .NOT.LSAME( NORM, 'I' )",
			"js": "!(norm === '1' || norm === 'one-norm') && norm !== 'inf-norm'"
		},
		{
			"info": -2,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.UPPER .AND. .NOT.LSAME( UPLO, 'L' )",
			"js": "uplo !== 'upper' && uplo !== 'lower'"
		},
		{
			"info": -3,
			"param": "DIAG",
			"kind": "enum",
			"fortranValues": "NU",
			"values": [
				"non-unit",
				"unit"
			],
			"fortran": ".NOT.NOUNIT .AND. .NOT.LSAME( DIAG, 'U' )",
			"js": "diag !== 'non-unit' && diag !== 'unit'"
		},
		{
			"info": -4,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -6,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDA.LT.MAX( 1, N )",
			"js": "lda < max( 1, N )"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0",
			"js": "N === 0",
			"sets": [
				"RCOND = ONE"
			]
		}
	]
}
