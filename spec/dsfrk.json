			"rowMajor": "lda < max( 1, trans === 'no-transpose' ? K : N )"
		}
	],
	"quickReturn": [
		{
			"fortran": "( N.EQ.0 ) .OR. ( ( ( ALPHA.EQ.ZERO ) .OR. ( K.EQ.0 ) ) .AND. ( BETA.EQ.ONE ) )",
			"js": "N === 0 || ((alpha === 0 || K === 0) && beta === 1)"
