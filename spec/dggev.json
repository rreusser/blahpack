			"fortran": "LDVL.LT.1 .OR. ( ILVL .AND. LDVL.LT.N )",
			"js": "ldvl < 1 || ((jobvl === 'no-vectors' ? false : (jobvl === 'compute-vectors' ? true : false)) && ldvl < N)"
