			"info": -3,
			"param": "L",
			"kind": "expr",
			"fortran": "L.LT.0 .OR. (L.GT.MIN(M,N) .AND. MIN(M,N).GE.0)",
			"js": "L < 0 || (L > min( M, N ) && min( M, N ) >= 0)"
		},
