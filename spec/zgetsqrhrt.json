	],
	"quickReturn": [
		{
			"fortran": "MIN( M, N ).EQ.0",
			"js": "min( M, N ) === 0",
			"sets": [
				"WORK( 1 ) = DCMPLX( LWORKOPT )"
			]
		}
	],
	"untranslated": [
		"WORK.minLength: local LWORKOPT is assigned inside nested control flow"
	]
