{
	"routine": "zgelss",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZGELSS( M, N, NRHS, A, LDA, B, LDB, S, RCOND, RANK,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "M",
			"fortran": "M",
			"position": 1,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 2,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "nrhs",
			"fortran": "NRHS",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 4,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDA",
				"N"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "M",
				"js": "M"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			},
			"workDependent": "on exit A's right singular vectors are determined only up to sign, and which ones LWORK's path returns differs; its other rows are scratch"
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 5,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		},
		{
			"name": "B",
			"fortran": "B",
			"position": 6,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDB",
				"NRHS"
			],
			"ld": "LDB",
			"rows": {
				"fortran": "MAXMN",
				"js": "max( M, N )"
			},
			"cols": {
				"fortran": "NRHS",
				"js": "nrhs"
			},
			"workDependent": "when M > N its rows N..M-1 hold the residual in a basis that depends on the path LWORK selects; only their sum of squares is defined"
		},
		{
			"name": "ldb",
			"fortran": "LDB",
			"position": 7,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "B"
		},
		{
			"name": "s",
			"fortran": "S",
			"position": 8,
			"role": "vector",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"MIN(M,N)"
			],
			"length": {
				"fortran": "MIN(M,N)",
				"js": "min( M, N )"
			}
		},
		{
			"name": "rcond",
			"fortran": "RCOND",
			"position": 9,
			"role": "scalar",
			"dtype": "float64",
			"intent": "in"
		},
		{
			"name": "rank",
			"fortran": "RANK",
			"position": 10,
			"role": "scalar",
			"dtype": "int32",
			"intent": "out"
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 11,
			"role": "workspace",
			"dtype": "complex128",
			"intent": "out",
			"dims": [
				"MAX(1,LWORK)"
			],
			"minLength": {
				"fortran": "MINWRK",
				"js": null,
				"source": "check"
			},
			"adaptive": true
		},
		{
			"name": "lwork",
			"fortran": "LWORK",
			"position": 12,
			"role": "lwork",
			"dtype": "int32",
			"intent": "in",
			"of": "WORK"
		},
		{
			"name": "RWORK",
			"fortran": "RWORK",
			"position": 13,
			"role": "workspace",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"5*MIN(M,N)"
			],
			"length": {
				"fortran": "5*MIN(M,N)",
				"js": "5 * min( M, N )"
			},
			"minLength": {
				"fortran": "5*MIN(M,N)",
				"js": "5 * min( M, N )",
				"source": "dimension"
			}
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 14,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "M",
			"kind": "nonnegative",
			"fortran": "M.LT.0",
			"js": "M < 0"
		},
		{
			"info": -2,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -3,
			"param": "NRHS",
			"kind": "nonnegative",
			"fortran": "NRHS.LT.0",
			"js": "nrhs < 0"
		},
		{
			"info": -5,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,M)",
				"js": "max( 1, M )"
			},
			"fortran": "LDA.LT.MAX( 1, M )",
			"js": "lda < max( 1, M )",
			"rowMajor": "lda < max( 1, N )"
		},
		{
			"info": -7,
			"param": "LDB",
			"kind": "ld",
			"matrix": "B",
			"min": {
				"fortran": "MAX(1,MAXMN)",
				"js": "max( 1, max( M, N ) )"
			},
			"fortran": "LDB.LT.MAX( 1, MAXMN )",
			"js": "ldb < max( 1, max( M, N ) )",
			"rowMajor": "ldb < max( 1, nrhs )"
		}
	],
	"quickReturn": [
		{
			"fortran": "M.EQ.0 .OR. N.EQ.0",
			"js": "M === 0 || N === 0",
			"sets": [
				"RANK = 0"
			]
		}
	],
	"tuning": [
		{
			"fn": "ilaenv",
			"ispec": "6",
			"name": "ZGELSS",
			"into": "MNTHR"
		},
		{
			"fn": "ilaenv",
			"ispec": "1",
			"name": "ZGEQRF",
			"into": "MAXWRK"
		},
		{
			"fn": "ilaenv",
			"ispec": "1",
			"name": "ZUNMQR",
			"into": "MAXWRK"
		}
	],
	"untranslated": [
		"WORK.minLength: local MINWRK is assigned inside nested control flow"
	],
	"overrides": [
		{
			"reason": "ZGELSS picks its path (QR first, LQ first, or direct bidiagonalization) from LWORK. On exit A holds the right singular vectors in its first min(M,N) rows, but singular vectors are determined only up to sign (and within the subspace of a repeated singular value), so a different path can return different ones; the remaining rows are scratch. Rows N..M-1 of B, when M > N, carry the residual, which the reference defines only through its sum of squares (\"the residual sum-of-squares ... is given by the sum of squares of elements n+1:m\"), in a basis that depends on the path. S, RANK and rows 1..N of B (the solution) do not depend on LWORK; the module's tests check the solution at the minimum WORK (ticket 0096).",
			"set": {
				"params.A.workDependent": "on exit A's right singular vectors are determined only up to sign, and which ones LWORK's path returns differs; its other rows are scratch",
				"params.B.workDependent": "when M > N its rows N..M-1 hold the residual in a basis that depends on the path LWORK selects; only their sum of squares is defined"
			}
		}
	]
}
