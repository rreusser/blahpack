{
	"routine": "dggbak",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DGGBAK( JOB, SIDE, N, ILO, IHI, LSCALE, RSCALE, M, V,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "job",
			"fortran": "JOB",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "side",
			"fortran": "SIDE",
			"position": 2,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "ilo",
			"fortran": "ILO",
			"position": 4,
			"role": "scalar",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "ihi",
			"fortran": "IHI",
			"position": 5,
			"role": "scalar",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "LSCALE",
			"fortran": "LSCALE",
			"position": 6,
			"role": "vector",
			"dtype": "float64",
			"intent": "in",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "RSCALE",
			"fortran": "RSCALE",
			"position": 7,
			"role": "vector",
			"dtype": "float64",
			"intent": "in",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "M",
			"fortran": "M",
			"position": 8,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "V",
			"fortran": "V",
			"position": 9,
			"role": "matrix",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDV",
				"M"
			],
			"ld": "LDV",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "M",
				"js": "M"
			}
		},
		{
			"name": "ldv",
			"fortran": "LDV",
			"position": 10,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "V"
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 11,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "JOB",
			"kind": "enum",
			"fortranValues": "BNPS",
			"values": [
				"both",
				"none",
				"permute",
				"scale"
			],
			"fortran": ".NOT.LSAME( JOB, 'N' ) .AND. .NOT.LSAME( JOB, 'P' ) .AND. .NOT.LSAME( JOB, 'S' ) .AND. .NOT.LSAME( JOB, 'B' )",
			"js": "job !== 'none' && job !== 'permute' && job !== 'scale' && job !== 'both'"
		},
		{
			"info": -2,
			"param": "SIDE",
			"kind": "enum",
			"fortranValues": "LR",
			"values": [
				"left",
				"right"
			],
			"fortran": ".NOT.RIGHTV .AND. .NOT.LEFTV",
			"js": "side !== 'right' && side !== 'left'"
		},
		{
			"info": -3,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -4,
			"param": "ILO",
			"kind": "expr",
			"fortran": "ILO.LT.1",
			"js": "ilo < 1"
		},
		{
			"info": -4,
			"param": "ILO",
			"kind": "expr",
			"fortran": "N.EQ.0 .AND. IHI.EQ.0 .AND. ILO.NE.1",
			"js": "N === 0 && ihi === 0 && ilo !== 1"
		},
		{
			"info": -5,
			"param": "IHI",
			"kind": "expr",
			"fortran": "N.GT.0 .AND. ( IHI.LT.ILO .OR. IHI.GT.MAX( 1, N ) )",
			"js": "N > 0 && (ihi < ilo || ihi > max( 1, N ))"
		},
		{
			"info": -5,
			"param": "IHI",
			"kind": "expr",
			"fortran": "N.EQ.0 .AND. ILO.EQ.1 .AND. IHI.NE.0",
			"js": "N === 0 && ilo === 1 && ihi !== 0"
		},
		{
			"info": -8,
			"param": "M",
			"kind": "nonnegative",
			"fortran": "M.LT.0",
			"js": "M < 0"
		},
		{
			"info": -10,
			"param": "LDV",
			"kind": "ld",
			"matrix": "V",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDV.LT.MAX( 1, N )",
			"js": "ldv < max( 1, N )",
			"rowMajor": "ldv < max( 1, M )"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0",
			"js": "N === 0"
		},
		{
			"fortran": "M.EQ.0",
			"js": "M === 0"
		},
		{
			"fortran": "LSAME( JOB, 'N' )",
			"js": "job === 'none'"
		}
	]
}
