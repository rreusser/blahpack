{
	"routine": "zunml2",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZUNML2( SIDE, TRANS, M, N, K, A, LDA, TAU, C, LDC,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "side",
			"fortran": "SIDE",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in",
			"reference": "-   `= 'L'`: apply Q or $Q^H$ from the Left\n-   `= 'R'`: apply Q or $Q^H$ from the Right"
		},
		{
			"name": "trans",
			"fortran": "TRANS",
			"position": 2,
			"role": "flag",
			"dtype": "string",
			"intent": "in",
			"reference": "-   `= 'N'`: apply Q  (No transpose)\n-   `= 'C'`: apply $Q^H$ (Conjugate transpose)"
		},
		{
			"name": "M",
			"fortran": "M",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in",
			"reference": "The number of rows of the matrix C. $M \\ge 0$."
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 4,
			"role": "dim",
			"dtype": "int32",
			"intent": "in",
			"reference": "The number of columns of the matrix C. $N \\ge 0$."
		},
		{
			"name": "K",
			"fortran": "K",
			"position": 5,
			"role": "dim",
			"dtype": "int32",
			"intent": "in",
			"reference": "The number of elementary reflectors whose product defines the matrix Q. If `SIDE = 'L'`, $M \\ge K \\ge 0$; if `SIDE = 'R'`, $N \\ge K \\ge 0$."
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 6,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"LDA",
				"M"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "K",
				"js": "K"
			},
			"cols": {
				"fortran": "M",
				"js": "side === 'left' ? M : N"
			},
			"reference": "(`LDA`,N) if `SIDE = 'R'` The i-th row must contain the vector which defines the elementary reflector H(i), for $i = 1$,2,...,k, as returned by ZGELQF in the first k rows of its array argument A. A is modified by the routine but restored on exit."
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 7,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A",
			"reference": "The leading dimension of the array A. $\\mathrm{LDA} \\ge \\max (1,K)$."
		},
		{
			"name": "TAU",
			"fortran": "TAU",
			"position": 8,
			"role": "vector",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"K"
			],
			"length": {
				"fortran": "K",
				"js": "K"
			},
			"reference": "`TAU(i)` must contain the scalar factor of the elementary reflector H(i), as returned by ZGELQF."
		},
		{
			"name": "C",
			"fortran": "C",
			"position": 9,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDC",
				"N"
			],
			"ld": "LDC",
			"rows": {
				"fortran": "M",
				"js": "M"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			},
			"reference": "On entry, the m-by-n matrix C. On exit, C is overwritten by $Q \\, C$ or $Q^H \\, C$ or $C \\, Q^H$ or $C \\, Q$."
		},
		{
			"name": "ldc",
			"fortran": "LDC",
			"position": 10,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "C",
			"reference": "The leading dimension of the array C. $\\mathrm{LDC} \\ge \\max (1,M)$."
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 11,
			"role": "workspace",
			"dtype": "complex128",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "(N) if SIDE = 'L' or (M) if SIDE = 'R'",
				"js": "( side === 'left' ) ? N : M"
			},
			"minLength": {
				"fortran": "N",
				"js": "N",
				"source": "dimension"
			},
			"reference": "(M) if `SIDE = 'R'`"
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 12,
			"role": "info",
			"dtype": "int32",
			"intent": "out",
			"reference": "-   `= 0`: successful exit\n-   `< 0`: if `INFO = -i`, the i-th argument had an illegal value"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "SIDE",
			"kind": "enum",
			"fortranValues": "LR",
			"values": [
				"left",
				"right"
			],
			"fortran": ".NOT.LEFT .AND. .NOT.LSAME( SIDE, 'R' )",
			"js": "side !== 'left' && side !== 'right'"
		},
		{
			"info": -2,
			"param": "TRANS",
			"kind": "enum",
			"fortranValues": "CN",
			"values": [
				"conjugate-transpose",
				"no-transpose"
			],
			"fortran": ".NOT.NOTRAN .AND. .NOT.LSAME( TRANS, 'C' )",
			"js": "trans !== 'no-transpose' && trans !== 'conjugate-transpose'"
		},
		{
			"info": -3,
			"param": "M",
			"kind": "nonnegative",
			"fortran": "M.LT.0",
			"js": "M < 0"
		},
		{
			"info": -4,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -5,
			"param": "K",
			"kind": "expr",
			"fortran": "K.LT.0 .OR. K.GT.NQ",
			"js": "K < 0 || K > (side === 'left' ? M : N)"
		},
		{
			"info": -7,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,K)",
				"js": "max( 1, K )"
			},
			"fortran": "LDA.LT.MAX( 1, K )",
			"js": "lda < max( 1, K )",
			"rowMajor": "lda < max( 1, side === 'left' ? M : N )"
		},
		{
			"info": -10,
			"param": "LDC",
			"kind": "ld",
			"matrix": "C",
			"min": {
				"fortran": "MAX(1,M)",
				"js": "max( 1, M )"
			},
			"fortran": "LDC.LT.MAX( 1, M )",
			"js": "ldc < max( 1, M )",
			"rowMajor": "ldc < max( 1, N )"
		}
	],
	"quickReturn": [
		{
			"fortran": "M.EQ.0 .OR. N.EQ.0 .OR. K.EQ.0",
			"js": "(M === 0 || N === 0) || K === 0"
		}
	]
}
