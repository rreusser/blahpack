{
	"routine": "zgttrs",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZGTTRS( TRANS, N, NRHS, DL, D, DU, DU2, IPIV, B, LDB,",
	"returns": {
