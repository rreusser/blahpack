		},
		{
			"name": "BB",
			"fortran": "BB",
			"position": 8,
			"role": "banded",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"LDBB",
				"N"
			],
			"ld": "LDBB",
			"rows": {
				"fortran": "KB+1",
