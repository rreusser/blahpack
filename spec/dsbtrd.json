{
	"routine": "dsbtrd",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DSBTRD( VECT, UPLO, N, KD, AB, LDAB, D, E, Q, LDQ,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "vect",
			"fortran": "VECT",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "uplo",
			"fortran": "UPLO",
			"position": 2,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "kd",
			"fortran": "KD",
			"position": 4,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "AB",
			"fortran": "AB",
			"position": 5,
			"role": "banded",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDAB",
				"N"
			],
			"ld": "LDAB",
			"rows": {
				"fortran": "KD1",
				"js": "kd + 1"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldab",
			"fortran": "LDAB",
			"position": 6,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "AB"
		},
		{
			"name": "d",
			"fortran": "D",
			"position": 7,
			"role": "vector",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "e",
			"fortran": "E",
			"position": 8,
			"role": "vector",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"N-1"
			],
			"length": {
				"fortran": "N-1",
				"js": "N - 1"
			}
		},
		{
			"name": "Q",
			"fortran": "Q",
			"position": 9,
			"role": "banded",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDQ",
				"N"
			],
			"ld": "LDQ",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldq",
			"fortran": "LDQ",
			"position": 10,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "Q"
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 11,
			"role": "workspace",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			},
			"minLength": {
				"fortran": "N",
				"js": "N",
				"source": "dimension"
			}
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 12,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "VECT",
			"kind": "enum",
			"fortranValues": "NUV",
			"values": [
				"none",
				"update",
				"initialize"
			],
			"fortran": ".NOT.WANTQ .AND. .NOT.LSAME( VECT, 'N' )",
			"js": "!(vect === 'initialize' || vect === 'update') && vect !== 'none'"
		},
		{
			"info": -2,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.UPPER .AND. .NOT.LSAME( UPLO, 'L' )",
			"js": "uplo !== 'upper' && uplo !== 'lower'"
		},
		{
			"info": -3,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -4,
			"param": "KD",
			"kind": "nonnegative",
			"fortran": "KD.LT.0",
			"js": "kd < 0"
		},
		{
			"info": -6,
			"param": "LDAB",
			"kind": "ld",
			"matrix": "AB",
			"min": {
				"fortran": "KD1",
				"js": "kd + 1"
			},
			"fortran": "LDAB.LT.KD1",
			"js": "ldab < kd + 1"
		},
		{
			"info": -10,
			"param": "LDQ",
			"kind": "expr",
			"fortran": "LDQ.LT.MAX( 1, N ) .AND. WANTQ",
			"js": "ldq < max( 1, N ) && (vect === 'initialize' || vect === 'update')"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0",
			"js": "N === 0"
		}
	]
}
