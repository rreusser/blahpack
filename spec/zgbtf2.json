{
	"routine": "zgbtf2",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZGBTF2( M, N, KL, KU, AB, LDAB, IPIV, INFO )",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "M",
			"fortran": "M",
			"position": 1,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 2,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "kl",
			"fortran": "KL",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "ku",
			"fortran": "KU",
			"position": 4,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "AB",
			"fortran": "AB",
			"position": 5,
			"role": "banded",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDAB",
				"N"
			],
			"ld": "LDAB",
			"rows": {
				"fortran": "KL+KV+1",
				"js": "kl + (ku + kl) + 1"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldab",
			"fortran": "LDAB",
			"position": 6,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "AB"
		},
		{
			"name": "IPIV",
			"fortran": "IPIV",
			"position": 7,
			"role": "index",
			"dtype": "int32",
			"intent": "out",
			"dims": [
				"MIN(M,N)"
			],
			"length": {
				"fortran": "MIN(M,N)",
				"js": "min( M, N )"
			}
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 8,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "M",
			"kind": "nonnegative",
			"fortran": "M.LT.0",
			"js": "M < 0"
		},
		{
			"info": -2,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -3,
			"param": "KL",
			"kind": "nonnegative",
			"fortran": "KL.LT.0",
			"js": "kl < 0"
		},
		{
			"info": -4,
			"param": "KU",
			"kind": "nonnegative",
			"fortran": "KU.LT.0",
			"js": "ku < 0"
		},
		{
			"info": -6,
			"param": "LDAB",
			"kind": "ld",
			"matrix": "AB",
			"min": {
				"fortran": "KL+KV+1",
				"js": "kl + (ku + kl) + 1"
			},
			"fortran": "LDAB.LT.KL+KV+1",
			"js": "ldab < kl + (ku + kl) + 1"
		}
	],
	"quickReturn": [
		{
			"fortran": "M.EQ.0 .OR. N.EQ.0",
			"js": "M === 0 || N === 0"
		}
	]
}
