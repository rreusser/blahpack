			"info": 7,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,NROWA)",
				"js": "max( 1, trans === 'no-transpose' ? N : K )"
			},
			"fortran": "LDA.LT.MAX(1,NROWA)",
			"js": "lda < max( 1, trans === 'no-transpose' ? N : K )"
		},
		{
			"info": 9,
			"param": "LDB",
