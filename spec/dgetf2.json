{
	"routine": "dgetf2",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DGETF2( M, N, A, LDA, IPIV, INFO )",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "M",
			"fortran": "M",
			"position": 1,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 2,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 3,
			"role": "matrix",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDA",
				"N"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "M",
				"js": "M"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 4,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		},
		{
			"name": "IPIV",
			"fortran": "IPIV",
			"position": 5,
			"role": "index",
			"dtype": "int32",
			"intent": "out",
			"dims": [
				"MIN(M,N)"
			],
			"length": {
				"fortran": "MIN(M,N)",
				"js": "min( M, N )"
			}
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 6,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "M",
			"kind": "nonnegative",
			"fortran": "M.LT.0",
			"js": "M < 0"
		},
		{
			"info": -2,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -4,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,M)",
				"js": "max( 1, M )"
			},
			"fortran": "LDA.LT.MAX( 1, M )",
			"js": "lda < max( 1, M )"
		}
	],
	"quickReturn": [
		{
			"fortran": "M.EQ.0 .OR. N.EQ.0",
			"js": "M === 0 || N === 0"
		}
	]
}
