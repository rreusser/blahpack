				"no-vectors",
				"compute-vectors"
			],
			"fortran": "( .NOT.WANTVS ) .AND. ( .NOT.LSAME( JOBVS, 'N' ) )",
			"js": "jobvs !== 'compute-vectors' && jobvs !== 'no-vectors'"
		},
		{
			"info": -2,
			"param": "SORT",
			"kind": "enum",
			"fortranValues": "NS",
			"values": [
				"none",
				"sort"
			],
			"fortran": "( .NOT.WANTST ) .AND. ( .NOT.LSAME( SORT, 'N' ) )",
			"js": "sort !== 'sort' && sort !== 'none'"
		},
		{
			"info": -4,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -6,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
