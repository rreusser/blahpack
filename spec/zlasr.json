{
	"routine": "zlasr",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZLASR( SIDE, PIVOT, DIRECT, M, N, C, S, A, LDA )",
	"returns": {
		"kind": "array",
		"param": "A"
	},
	"params": [
		{
			"name": "side",
			"fortran": "SIDE",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "pivot",
			"fortran": "PIVOT",
			"position": 2,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "direct",
			"fortran": "DIRECT",
