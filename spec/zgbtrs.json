{
	"routine": "zgbtrs",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZGBTRS( TRANS, N, KL, KU, NRHS, AB, LDAB, IPIV, B, LDB,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "trans",
			"fortran": "TRANS",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 2,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "kl",
			"fortran": "KL",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "ku",
			"fortran": "KU",
			"position": 4,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "nrhs",
			"fortran": "NRHS",
			"position": 5,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "AB",
			"fortran": "AB",
			"position": 6,
			"role": "banded",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"LDAB",
				"N"
			],
			"ld": "LDAB",
			"rows": {
				"fortran": "2*KL+KU+1",
				"js": "2 * kl + ku + 1"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldab",
			"fortran": "LDAB",
			"position": 7,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "AB"
		},
		{
			"name": "IPIV",
			"fortran": "IPIV",
			"position": 8,
			"role": "index",
			"dtype": "int32",
			"intent": "in",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "B",
			"fortran": "B",
			"position": 9,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDB",
				"NRHS"
			],
			"ld": "LDB",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "NRHS",
				"js": "nrhs"
			}
		},
		{
			"name": "ldb",
			"fortran": "LDB",
			"position": 10,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "B"
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 11,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "TRANS",
			"kind": "enum",
			"fortranValues": "CNT",
			"values": [
				"conjugate-transpose",
				"no-transpose",
				"transpose"
			],
			"fortran": ".NOT.NOTRAN .AND. .NOT.LSAME( TRANS, 'T' ) .AND. .NOT. LSAME( TRANS, 'C' )",
			"js": "trans !== 'no-transpose' && trans !== 'transpose' && trans !== 'conjugate-transpose'"
		},
		{
			"info": -2,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -3,
			"param": "KL",
			"kind": "nonnegative",
			"fortran": "KL.LT.0",
			"js": "kl < 0"
		},
		{
			"info": -4,
			"param": "KU",
			"kind": "nonnegative",
			"fortran": "KU.LT.0",
			"js": "ku < 0"
		},
		{
			"info": -5,
			"param": "NRHS",
			"kind": "nonnegative",
			"fortran": "NRHS.LT.0",
			"js": "nrhs < 0"
		},
		{
			"info": -7,
			"param": "LDAB",
			"kind": "ld",
			"matrix": "AB",
			"min": {
				"fortran": "2*KL+KU+1",
				"js": "2 * kl + ku + 1"
			},
			"fortran": "LDAB.LT.( 2*KL+KU+1 )",
			"js": "ldab < 2 * kl + ku + 1",
			"rowMajor": "ldab < max( 1, N )"
		},
		{
			"info": -10,
			"param": "LDB",
			"kind": "ld",
			"matrix": "B",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDB.LT.MAX( 1, N )",
			"js": "ldb < max( 1, N )",
			"rowMajor": "ldb < max( 1, nrhs )"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0 .OR. NRHS.EQ.0",
			"js": "N === 0 || nrhs === 0"
		}
	]
}
