{
	"routine": "dopgtr",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DOPGTR( UPLO, N, AP, TAU, Q, LDQ, WORK, INFO )",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "uplo",
			"fortran": "UPLO",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in",
			"reference": "-   `= 'U'`: Upper triangular packed storage used in previous call to DSPTRD;\n-   `= 'L'`: Lower triangular packed storage used in previous call to DSPTRD."
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 2,
			"role": "dim",
			"dtype": "int32",
			"intent": "in",
			"reference": "The order of the matrix Q. $N \\ge 0$."
		},
		{
			"name": "AP",
			"fortran": "AP",
			"position": 3,
			"role": "packed",
			"format": "packed",
			"dtype": "float64",
			"intent": "in",
			"dims": [
				"N*(N+1)/2"
			],
			"length": {
				"fortran": "N*(N+1)/2",
				"js": "trunc( N * (N + 1) / 2 )"
			},
			"reference": "The vectors which define the elementary reflectors, as returned by DSPTRD."
		},
		{
			"name": "TAU",
			"fortran": "TAU",
			"position": 4,
			"role": "vector",
			"dtype": "float64",
			"intent": "in",
			"dims": [
				"N-1"
			],
			"length": {
				"fortran": "N-1",
				"js": "N - 1"
			},
			"reference": "`TAU(i)` must contain the scalar factor of the elementary reflector H(i), as returned by DSPTRD."
		},
		{
			"name": "Q",
			"fortran": "Q",
			"position": 5,
			"role": "matrix",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"LDQ",
				"N"
			],
			"ld": "LDQ",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			},
			"reference": "The N-by-N orthogonal matrix Q."
		},
		{
			"name": "ldq",
			"fortran": "LDQ",
			"position": 6,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "Q",
			"reference": "The leading dimension of the array Q. $\\mathrm{LDQ} \\ge \\max (1,N)$."
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 7,
			"role": "workspace",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"N-1"
			],
			"length": {
				"fortran": "N-1",
				"js": "N - 1"
			},
			"minLength": {
				"fortran": "N-1",
				"js": "N - 1",
				"source": "dimension"
			}
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 8,
			"role": "info",
			"dtype": "int32",
			"intent": "out",
			"reference": "-   `= 0`: successful exit\n-   `< 0`: if `INFO = -i`, the i-th argument had an illegal value"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.UPPER .AND. .NOT.LSAME( UPLO, 'L' )",
			"js": "uplo !== 'upper' && uplo !== 'lower'"
		},
		{
			"info": -2,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -6,
			"param": "LDQ",
			"kind": "ld",
			"matrix": "Q",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDQ.LT.MAX( 1, N )",
			"js": "ldq < max( 1, N )"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0",
			"js": "N === 0"
		}
	]
}
