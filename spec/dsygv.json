{
	"routine": "dsygv",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DSYGV( ITYPE, JOBZ, UPLO, N, A, LDA, B, LDB, W, WORK,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "itype",
			"fortran": "ITYPE",
			"position": 1,
			"role": "scalar",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "jobz",
			"fortran": "JOBZ",
			"position": 2,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "uplo",
			"fortran": "UPLO",
			"position": 3,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 4,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 5,
			"role": "matrix",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDA",
				"N"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 6,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		},
		{
			"name": "B",
			"fortran": "B",
			"position": 7,
			"role": "matrix",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDB",
				"N"
			],
			"ld": "LDB",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldb",
			"fortran": "LDB",
			"position": 8,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "B"
		},
		{
			"name": "w",
			"fortran": "W",
			"position": 9,
			"role": "vector",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 10,
			"role": "workspace",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"MAX(1,LWORK)"
			],
			"minLength": {
				"fortran": "LWKMIN",
				"js": "max( 1, 3 * N - 1 )",
				"source": "check"
			}
		},
		{
			"name": "lwork",
			"fortran": "LWORK",
			"position": 11,
			"role": "lwork",
			"dtype": "int32",
			"intent": "in",
			"of": "WORK"
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 12,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "ITYPE",
			"kind": "expr",
			"fortran": "ITYPE.LT.1 .OR. ITYPE.GT.3",
			"js": "itype < 1 || itype > 3"
		},
		{
			"info": -2,
			"param": "JOBZ",
			"kind": "enum",
			"fortranValues": "NV",
			"values": [
				"no-vectors",
				"compute-vectors"
			],
			"fortran": ".NOT.( WANTZ .OR. LSAME( JOBZ, 'N' ) )",
			"js": "!(jobz === 'compute-vectors' || jobz === 'no-vectors')"
		},
		{
			"info": -3,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.( UPPER .OR. LSAME( UPLO, 'L' ) )",
			"js": "!(uplo === 'upper' || uplo === 'lower')"
		},
		{
			"info": -4,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -6,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDA.LT.MAX( 1, N )",
			"js": "lda < max( 1, N )"
		},
		{
			"info": -8,
			"param": "LDB",
			"kind": "ld",
			"matrix": "B",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDB.LT.MAX( 1, N )",
			"js": "ldb < max( 1, N )"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0",
			"js": "N === 0"
		}
	]
}
