			}
		},
		{
			"name": "RWORK",
			"fortran": "RWORK",
			"position": 13,
			"role": "workspace",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
