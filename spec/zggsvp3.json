			"info": -20,
			"param": "LDQ",
			"kind": "expr",
			"fortran": "LDQ.LT.1 .OR. ( WANTQ .AND. LDQ.LT.N )",
			"js": "ldq < 1 || (jobq === 'compute-Q' && ldq < N)"
		}
