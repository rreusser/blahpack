{
	"routine": "zgeru",
	"package": "blas",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZGERU(M,N,ALPHA,X,INCX,Y,INCY,A,LDA)",
	"returns": {
		"kind": "array",
		"param": "A"
	},
	"params": [
		{
			"name": "M",
			"fortran": "M",
			"position": 1,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 2,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "alpha",
			"fortran": "ALPHA",
			"position": 3,
			"role": "scalar",
			"dtype": "complex128",
			"intent": "in"
		},
		{
			"name": "x",
			"fortran": "X",
			"position": 4,
			"role": "vector",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"1+(M-1)*ABS(INCX)"
			],
			"length": {
				"fortran": "M",
				"js": "M"
			}
		},
		{
			"name": "incx",
			"fortran": "INCX",
			"position": 5,
			"role": "inc",
			"dtype": "int32",
			"intent": "in",
			"of": "X"
		},
		{
			"name": "y",
			"fortran": "Y",
			"position": 6,
			"role": "vector",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"1+(N-1)*ABS(INCY)"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "incy",
			"fortran": "INCY",
			"position": 7,
			"role": "inc",
			"dtype": "int32",
			"intent": "in",
			"of": "Y"
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 8,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDA",
				"N"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "M",
				"js": "M"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 9,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		}
	],
	"checks": [
		{
			"info": 1,
			"param": "M",
			"kind": "nonnegative",
			"fortran": "M.LT.0",
			"js": "M < 0"
		},
		{
			"info": 2,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": 5,
			"param": "INCX",
			"kind": "nonzero",
			"vector": "X",
			"fortran": "INCX.EQ.0",
			"js": "incx === 0"
		},
		{
			"info": 7,
			"param": "INCY",
			"kind": "nonzero",
			"vector": "Y",
			"fortran": "INCY.EQ.0",
			"js": "incy === 0"
		},
		{
			"info": 9,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,M)",
				"js": "max( 1, M )"
			},
			"fortran": "LDA.LT.MAX(1,M)",
			"js": "lda < max( 1, M )",
			"rowMajor": "lda < max( 1, N )"
		}
	],
	"quickReturn": [
		{
			"fortran": "(M.EQ.0) .OR. (N.EQ.0) .OR. (ALPHA.EQ.ZERO)",
			"js": "(M === 0 || N === 0) || (real( alpha ) === 0 && imag( alpha ) === 0)"
		}
	]
}
