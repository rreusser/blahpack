{
	"routine": "zpocon",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZPOCON( UPLO, N, A, LDA, ANORM, RCOND, WORK, RWORK,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "uplo",
			"fortran": "UPLO",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in",
			"reference": "-   `= 'U'`: Upper triangle of A is stored;\n-   `= 'L'`: Lower triangle of A is stored."
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 2,
			"role": "dim",
			"dtype": "int32",
			"intent": "in",
			"reference": "The order of the matrix A. $N \\ge 0$."
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 3,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"LDA",
				"N"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			},
			"reference": "The triangular factor U or L from the Cholesky factorization $A = U^H \\, U$ or $A = L \\, L^H$, as computed by ZPOTRF."
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 4,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A",
			"reference": "The leading dimension of the array A. $\\mathrm{LDA} \\ge \\max (1,N)$."
		},
		{
			"name": "anorm",
			"fortran": "ANORM",
			"position": 5,
			"role": "scalar",
			"dtype": "float64",
			"intent": "in",
			"reference": "The 1-norm (or infinity-norm) of the Hermitian matrix A."
		},
		{
			"name": "rcond",
			"fortran": "RCOND",
			"position": 6,
			"role": "scalar",
			"dtype": "float64",
			"intent": "out",
			"reference": "The reciprocal of the condition number of the matrix A, computed as $\\mathrm{RCOND} = 1/(\\mathrm{ANORM} \\, \\mathrm{AINVNM})$, where AINVNM is an estimate of the 1-norm of inv(A) computed in this routine."
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 7,
			"role": "workspace",
			"dtype": "complex128",
			"intent": "out",
			"dims": [
				"2*N"
			],
			"length": {
				"fortran": "2*N",
				"js": "2 * N"
			},
			"minLength": {
				"fortran": "2*N",
				"js": "2 * N",
				"source": "dimension"
			}
		},
		{
			"name": "RWORK",
			"fortran": "RWORK",
			"position": 8,
			"role": "workspace",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			},
			"minLength": {
				"fortran": "N",
				"js": "N",
				"source": "dimension"
			}
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 9,
			"role": "info",
			"dtype": "int32",
			"intent": "out",
			"reference": "-   `= 0`: successful exit\n-   `< 0`: if `INFO = -i`, the i-th argument had an illegal value"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.UPPER .AND. .NOT.LSAME( UPLO, 'L' )",
			"js": "uplo !== 'upper' && uplo !== 'lower'"
		},
		{
			"info": -2,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -4,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDA.LT.MAX( 1, N )",
			"js": "lda < max( 1, N )"
		},
		{
			"info": -5,
			"param": "ANORM",
			"kind": "expr",
			"fortran": "ANORM.LT.ZERO",
			"js": "anorm < 0"
		}
	],
	"quickReturn": []
}
