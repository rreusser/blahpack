{
	"routine": "dtbtrs",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DTBTRS( UPLO, TRANS, DIAG, N, KD, NRHS, AB, LDAB, B,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "uplo",
			"fortran": "UPLO",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "trans",
			"fortran": "TRANS",
			"position": 2,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "diag",
			"fortran": "DIAG",
			"position": 3,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 4,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "kd",
			"fortran": "KD",
			"position": 5,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "nrhs",
			"fortran": "NRHS",
			"position": 6,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "AB",
			"fortran": "AB",
			"position": 7,
			"role": "banded",
			"dtype": "float64",
			"intent": "in",
			"dims": [
				"LDAB",
				"N"
			],
			"ld": "LDAB",
			"rows": {
				"fortran": "KD+1",
				"js": "kd + 1"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldab",
			"fortran": "LDAB",
			"position": 8,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "AB"
		},
		{
			"name": "B",
			"fortran": "B",
			"position": 9,
			"role": "matrix",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDB",
				"NRHS"
			],
			"ld": "LDB",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "NRHS",
				"js": "nrhs"
			}
		},
		{
			"name": "ldb",
			"fortran": "LDB",
			"position": 10,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "B"
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 11,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.UPPER .AND. .NOT.LSAME( UPLO, 'L' )",
			"js": "uplo !== 'upper' && uplo !== 'lower'"
		},
		{
			"info": -2,
			"param": "TRANS",
			"kind": "enum",
			"fortranValues": "CNT",
			"values": [
				"conjugate-transpose",
				"no-transpose",
				"transpose"
			],
			"fortran": ".NOT.LSAME( TRANS, 'N' ) .AND. .NOT. LSAME( TRANS, 'T' ) .AND. .NOT.LSAME( TRANS, 'C' )",
			"js": "trans !== 'no-transpose' && trans !== 'transpose' && trans !== 'conjugate-transpose'"
		},
		{
			"info": -3,
			"param": "DIAG",
			"kind": "enum",
			"fortranValues": "NU",
			"values": [
				"non-unit",
				"unit"
			],
			"fortran": ".NOT.NOUNIT .AND. .NOT.LSAME( DIAG, 'U' )",
			"js": "diag !== 'non-unit' && diag !== 'unit'"
		},
		{
			"info": -4,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -5,
			"param": "KD",
			"kind": "nonnegative",
			"fortran": "KD.LT.0",
			"js": "kd < 0"
		},
		{
			"info": -6,
			"param": "NRHS",
			"kind": "nonnegative",
			"fortran": "NRHS.LT.0",
			"js": "nrhs < 0"
		},
		{
			"info": -8,
			"param": "LDAB",
			"kind": "ld",
			"matrix": "AB",
			"min": {
				"fortran": "KD+1",
				"js": "kd + 1"
			},
			"fortran": "LDAB.LT.KD+1",
			"js": "ldab < kd + 1"
		},
		{
			"info": -10,
			"param": "LDB",
			"kind": "ld",
			"matrix": "B",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDB.LT.MAX( 1, N )",
			"js": "ldb < max( 1, N )"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0",
			"js": "N === 0"
		}
	]
}
