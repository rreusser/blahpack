{
	"routine": "zsteqr",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZSTEQR( COMPZ, N, D, E, Z, LDZ, WORK, INFO )",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "compz",
			"fortran": "COMPZ",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 2,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "d",
			"fortran": "D",
			"position": 3,
			"role": "vector",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "e",
			"fortran": "E",
			"position": 4,
			"role": "vector",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"N-1"
			],
			"length": {
				"fortran": "N-1",
				"js": "N - 1"
			}
		},
		{
			"name": "Z",
			"fortran": "Z",
			"position": 5,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDZ",
				"N"
			],
			"ld": "LDZ",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldz",
			"fortran": "LDZ",
			"position": 6,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "Z"
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 7,
			"role": "workspace",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"MAX(1,2*N-2)"
			],
			"length": {
				"fortran": "MAX(1,2*N-2)",
				"js": "max( 1, 2 * N - 2 )"
			},
			"minLength": {
				"fortran": "MAX(1,2*N-2)",
				"js": "max( 1, 2 * N - 2 )",
				"source": "dimension"
			}
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 8,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "COMPZ",
			"kind": "enum",
			"fortranValues": "INV",
			"values": [
				"initialize",
				"none",
				"update"
			],
			"fortran": "ICOMPZ.LT.0",
			"js": "(compz === 'none' ? 0 : (compz === 'update' ? 1 : (compz === 'initialize' ? 2 : -1))) < 0"
		},
		{
			"info": -2,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -6,
			"param": "LDZ",
			"kind": "expr",
			"fortran": "( LDZ.LT.1 ) .OR. ( ICOMPZ.GT.0 .AND. LDZ.LT.MAX( 1, N ) )",
			"js": "ldz < 1 || ((compz === 'none' ? 0 : (compz === 'update' ? 1 : (compz === 'initialize' ? 2 : -1))) > 0 && ldz < max( 1, N ))"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0",
			"js": "N === 0"
		},
		{
			"fortran": "N.EQ.1",
			"js": "N === 1",
			"sets": [
				"IF( ICOMPZ.EQ.2 ) Z( 1, 1 ) = CONE"
			]
		}
	]
}
