{
	"routine": "zhpgst",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZHPGST( ITYPE, UPLO, N, AP, BP, INFO )",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "itype",
			"fortran": "ITYPE",
			"position": 1,
			"role": "scalar",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "uplo",
			"fortran": "UPLO",
			"position": 2,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "AP",
			"fortran": "AP",
			"position": 4,
			"role": "packed",
			"format": "packed",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"N*(N+1)/2"
			],
			"length": {
				"fortran": "N*(N+1)/2",
				"js": "trunc( N * (N + 1) / 2 )"
			}
		},
		{
			"name": "BP",
			"fortran": "BP",
			"position": 5,
			"role": "packed",
			"format": "packed",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"N*(N+1)/2"
			],
			"length": {
				"fortran": "N*(N+1)/2",
				"js": "trunc( N * (N + 1) / 2 )"
			}
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 6,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "ITYPE",
			"kind": "expr",
			"fortran": "ITYPE.LT.1 .OR. ITYPE.GT.3",
			"js": "itype < 1 || itype > 3"
		},
		{
			"info": -2,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.UPPER .AND. .NOT.LSAME( UPLO, 'L' )",
			"js": "uplo !== 'upper' && uplo !== 'lower'"
		},
		{
			"info": -3,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		}
	],
	"quickReturn": []
}
