		{
			"info": -6,
			"param": "L",
			"kind": "expr",
			"fortran": "L.LT.0 .OR. L.GT.K",
			"js": "L < 0 || L > K"
		},
		{
			"info": -7,
			"param": "MB",
			"kind": "expr",
			"fortran": "MB.LT.1 .OR. (MB.GT.K .AND. K.GT.0)",
			"js": "mb < 1 || (mb > K && K > 0)"
		},
		{
			"info": -9,
			"param": "LDV",
			"kind": "ld",
			"matrix": "V",
			"min": {
				"fortran": "K",
				"js": "K"
			},
			"fortran": "LDV.LT.K",
			"js": "ldv < K"
		},
		{
			"info": -11,
			"param": "LDT",
			"kind": "ld",
			"matrix": "T",
			"min": {
				"fortran": "MB",
