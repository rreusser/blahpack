		{
			"name": "info",
			"fortran": "INFO",
			"position": 19,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "JOBZ",
			"kind": "enum",
			"fortranValues": "NV",
			"values": [
				"no-vectors",
				"compute-vectors"
			],
			"fortran": ".NOT.( WANTZ .OR. LSAME( JOBZ, 'N' ) )",
			"js": "!(jobz === 'compute-vectors' || jobz === 'no-vectors')"
		},
		{
			"info": -2,
			"param": "RANGE",
			"kind": "enum",
			"fortranValues": "AIV",
			"values": [
				"all",
				"index",
				"value"
			],
			"fortran": ".NOT.( ALLEIG .OR. VALEIG .OR. INDEIG )",
			"js": "!((range === 'all' || range === 'value') || range === 'index')"
		},
		{
			"info": -3,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.( LSAME( UPLO, 'L' ) .OR. LSAME( UPLO, 'U' ) )",
			"js": "!(uplo === 'lower' || uplo === 'upper')"
		},
		{
			"info": -4,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -7,
			"param": "VU",
			"kind": "expr",
			"fortran": "N.GT.0 .AND. VU.LE.VL",
			"guard": "VALEIG",
			"js": "range === 'value' && (N > 0 && vu <= vl)"
		},
		{
			"info": -8,
			"param": "IL",
			"kind": "expr",
			"fortran": "IL.LT.1 .OR. IL.GT.MAX( 1, N )",
			"guard": ".NOT.( VALEIG ) .AND. INDEIG",
			"js": "range !== 'value' && range === 'index' && (il < 1 || il > max( 1, N ))"
		},
		{
			"info": -9,
			"param": "IU",
			"kind": "expr",
			"fortran": "IU.LT.MIN( N, IL ) .OR. IU.GT.N",
			"guard": ".NOT.( VALEIG ) .AND. INDEIG",
			"js": "range !== 'value' && range === 'index' && (iu < min( N, il ) || iu > N)"
		},
		{
			"info": -14,
			"param": "LDZ",
			"kind": "expr",
			"fortran": "LDZ.LT.1 .OR. ( WANTZ .AND. LDZ.LT.N )",
			"js": "ldz < 1 || (jobz === 'compute-vectors' && ldz < N)"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0",
			"js": "N === 0"
		}
	]
}
