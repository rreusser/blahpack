{
	"routine": "zupmtr",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZUPMTR( SIDE, UPLO, TRANS, M, N, AP, TAU, C, LDC, WORK,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "side",
			"fortran": "SIDE",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "uplo",
			"fortran": "UPLO",
			"position": 2,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "trans",
			"fortran": "TRANS",
			"position": 3,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "M",
			"fortran": "M",
			"position": 4,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 5,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "AP",
			"fortran": "AP",
			"position": 6,
			"role": "packed",
			"format": "packed",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"M*(M+1)/2"
			],
			"length": {
				"fortran": "(M*(M+1)/2) if SIDE = 'L' or (N*(N+1)/2) if SIDE = 'R'",
				"js": "( side === 'left' ) ? trunc( M * (M + 1) / 2 ) : trunc( N * (N + 1) / 2 )"
			}
		},
		{
			"name": "TAU",
			"fortran": "TAU",
			"position": 7,
			"role": "vector",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"M-1"
			],
			"length": {
				"fortran": "(M-1) if SIDE = 'L' or (N-1) if SIDE = 'R'",
				"js": "( side === 'left' ) ? M - 1 : N - 1"
			}
		},
		{
			"name": "C",
			"fortran": "C",
			"position": 8,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDC",
				"N"
			],
			"ld": "LDC",
			"rows": {
				"fortran": "M",
				"js": "M"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldc",
			"fortran": "LDC",
			"position": 9,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "C"
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 10,
			"role": "workspace",
			"dtype": "complex128",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "(N) if SIDE = 'L' or (M) if SIDE = 'R'",
				"js": "( side === 'left' ) ? N : M"
			},
			"minLength": {
				"fortran": "N",
				"js": "N",
				"source": "dimension"
			}
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 11,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "SIDE",
			"kind": "enum",
			"fortranValues": "LR",
			"values": [
				"left",
				"right"
			],
			"fortran": ".NOT.LEFT .AND. .NOT.LSAME( SIDE, 'R' )",
			"js": "side !== 'left' && side !== 'right'"
		},
		{
			"info": -2,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.UPPER .AND. .NOT.LSAME( UPLO, 'L' )",
			"js": "uplo !== 'upper' && uplo !== 'lower'"
		},
		{
			"info": -3,
			"param": "TRANS",
			"kind": "enum",
			"fortranValues": "CN",
			"values": [
				"conjugate-transpose",
				"no-transpose"
			],
			"fortran": ".NOT.NOTRAN .AND. .NOT.LSAME( TRANS, 'C' )",
			"js": "trans !== 'no-transpose' && trans !== 'conjugate-transpose'"
		},
		{
			"info": -4,
			"param": "M",
			"kind": "nonnegative",
			"fortran": "M.LT.0",
			"js": "M < 0"
		},
		{
			"info": -5,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -9,
			"param": "LDC",
			"kind": "ld",
			"matrix": "C",
			"min": {
				"fortran": "MAX(1,M)",
				"js": "max( 1, M )"
			},
			"fortran": "LDC.LT.MAX( 1, M )",
			"js": "ldc < max( 1, M )",
			"rowMajor": "ldc < max( 1, N )"
		}
	],
	"quickReturn": [
		{
			"fortran": "M.EQ.0 .OR. N.EQ.0",
			"js": "M === 0 || N === 0"
		}
	]
}
