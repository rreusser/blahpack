		{
			"name": "info",
			"fortran": "INFO",
			"position": 14,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "VECT",
			"kind": "enum",
			"fortranValues": "NV",
			"values": [
				"none",
				"update"
			],
			"fortran": ".NOT.WANTX .AND. .NOT.LSAME( VECT, 'N' )",
			"js": "vect !== 'update' && vect !== 'none'"
		},
		{
			"info": -2,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.UPPER .AND. .NOT.LSAME( UPLO, 'L' )",
			"js": "uplo !== 'upper' && uplo !== 'lower'"
		},
		{
			"info": -3,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -4,
			"param": "KA",
			"kind": "nonnegative",
			"fortran": "KA.LT.0",
			"js": "ka < 0"
		},
		{
			"info": -5,
			"param": "KB",
			"kind": "expr",
			"fortran": "KB.LT.0 .OR. KB.GT.KA",
			"js": "kb < 0 || kb > ka"
		},
		{
			"info": -7,
			"param": "LDAB",
			"kind": "ld",
			"matrix": "AB",
			"min": {
				"fortran": "KA+1",
				"js": "ka + 1"
			},
			"fortran": "LDAB.LT.KA+1",
			"js": "ldab < ka + 1",
			"rowMajor": "ldab < max( 1, N )"
		},
		{
			"info": -9,
			"param": "LDBB",
			"kind": "ld",
			"matrix": "BB",
			"min": {
				"fortran": "KB+1",
				"js": "kb + 1"
			},
			"fortran": "LDBB.LT.KB+1",
			"js": "ldbb < kb + 1",
			"rowMajor": "ldbb < max( 1, N )"
		},
		{
			"info": -11,
			"param": "LDX",
			"kind": "expr",
			"fortran": "LDX.LT.1 .OR. WANTX .AND. LDX.LT.MAX( 1, N )",
			"js": "ldx < 1 || (vect === 'update' && ldx < max( 1, N ))"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0",
			"js": "N === 0"
		}
	]
}
