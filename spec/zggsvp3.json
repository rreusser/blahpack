			"kind": "enum",
			"fortranValues": "NU",
			"values": [
				"none",
				"compute-U"
			],
			"fortran": ".NOT.( WANTU .OR. LSAME( JOBU, 'N' ) )",
			"js": "!(jobu === 'compute-U' || jobu === 'none')"
		},
		{
			"info": -2,
			"param": "JOBV",
			"kind": "enum",
			"fortranValues": "NV",
			"values": [
				"none",
				"compute-V"
			],
			"fortran": ".NOT.( WANTV .OR. LSAME( JOBV, 'N' ) )",
