{
	"routine": "dtpttr",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DTPTTR( UPLO, N, AP, A, LDA, INFO )",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "uplo",
			"fortran": "UPLO",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 2,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "AP",
			"fortran": "AP",
			"position": 3,
			"role": "packed",
			"format": "packed",
			"dtype": "float64",
			"intent": "in",
			"dims": [
				"N*(N+1)/2"
			],
			"length": {
				"fortran": "N*(N+1)/2",
				"js": "trunc( N * (N + 1) / 2 )"
			}
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 4,
			"role": "matrix",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"LDA",
				"N"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 5,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 6,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.LOWER .AND. .NOT.LSAME( UPLO, 'U' )",
			"js": "uplo !== 'lower' && uplo !== 'upper'"
		},
		{
			"info": -2,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -5,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,N)",
				"js": "max( 1, N )"
			},
			"fortran": "LDA.LT.MAX( 1, N )",
			"js": "lda < max( 1, N )"
		}
	],
	"quickReturn": []
}
