{
	"routine": "zgeqrt",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZGEQRT( M, N, NB, A, LDA, T, LDT, WORK, INFO )",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "M",
			"fortran": "M",
			"position": 1,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 2,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "nb",
			"fortran": "NB",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 4,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDA",
				"N"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "M",
				"js": "M"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 5,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		},
		{
			"name": "T",
			"fortran": "T",
			"position": 6,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "out",
			"dims": [
				"LDT",
				"MIN(M,N)"
			],
			"ld": "LDT",
			"rows": {
				"fortran": "NB",
				"js": "nb"
			},
			"cols": {
				"fortran": "MIN(M,N)",
				"js": "min( M, N )"
			}
		},
		{
			"name": "ldt",
			"fortran": "LDT",
			"position": 7,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "T"
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 8,
			"role": "workspace",
			"dtype": "complex128",
			"intent": "out",
			"dims": [
				"NB*N"
			],
			"length": {
				"fortran": "NB*N",
				"js": "nb * N"
			},
			"minLength": {
				"fortran": "NB*N",
				"js": "nb * N",
				"source": "dimension"
			}
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 9,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "M",
			"kind": "nonnegative",
			"fortran": "M.LT.0",
			"js": "M < 0"
		},
		{
			"info": -2,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -3,
			"param": "NB",
			"kind": "expr",
			"fortran": "NB.LT.1 .OR. ( NB.GT.MIN(M,N) .AND. MIN(M,N).GT.0 )",
			"js": "nb < 1 || (nb > min( M, N ) && min( M, N ) > 0)"
		},
		{
			"info": -5,
			"param": "LDA",
			"kind": "ld",
			"matrix": "A",
			"min": {
				"fortran": "MAX(1,M)",
				"js": "max( 1, M )"
			},
			"fortran": "LDA.LT.MAX( 1, M )",
			"js": "lda < max( 1, M )"
		},
		{
			"info": -7,
			"param": "LDT",
			"kind": "ld",
			"matrix": "T",
			"min": {
				"fortran": "NB",
				"js": "nb"
			},
			"fortran": "LDT.LT.NB",
			"js": "ldt < nb"
		}
	],
	"quickReturn": [
		{
			"fortran": "K.EQ.0",
			"js": "min( M, N ) === 0"
		}
	]
}
