				"source": "dimension"
			}
		},
		{
			"name": "IWORK",
			"fortran": "IWORK",
			"position": 17,
			"role": "workspace",
			"dtype": "int32",
			"intent": "out",
			"dims": [
				"5*N"
			],
			"length": {
				"fortran": "5*N",
				"js": "5 * N"
			},
			"minLength": {
				"fortran": "5*N",
				"js": "5 * N",
				"source": "dimension"
			}
		},
		{
			"name": "IFAIL",
			"fortran": "IFAIL",
			"position": 18,
			"role": "index",
			"dtype": "int32",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
