			"info": -16,
			"param": "LDU",
			"kind": "expr",
			"fortran": "LDU.LT.1 .OR. ( WANTU .AND. LDU.LT.M )",
			"js": "ldu < 1 || (jobu === 'compute-U' && ldu < M)"
