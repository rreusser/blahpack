				"KA"
			],
			"ld": "LDA",
			"rows": {
				"fortran": "NROWA",
				"js": "trans === 'no-transpose' ? N : K"
			},
			"cols": {
				"fortran": "KA",
				"js": "trans === 'no-transpose' ? K : N"
			}
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 8,
			"role": "ld",
