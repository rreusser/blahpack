{
	"routine": "zlaswp",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZLASWP( N, A, LDA, K1, K2, IPIV, INCX )",
	"returns": {
		"kind": "array",
		"param": "A"
	},
	"params": [
		{
			"name": "N",
			"fortran": "N",
			"position": 1,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "A",
			"fortran": "A",
			"position": 2,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "inout",
			"dims": [
				"LDA",
				"N"
			],
			"ld": "LDA",
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "lda",
			"fortran": "LDA",
			"position": 3,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "A"
		},
		{
			"name": "k1",
			"fortran": "K1",
			"position": 4,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "k2",
			"fortran": "K2",
			"position": 5,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "IPIV",
			"fortran": "IPIV",
			"position": 6,
			"role": "index",
			"dtype": "int32",
			"intent": "in",
			"dims": [
				"K1+(K2-K1)*ABS(INCX)"
			],
			"length": {
				"fortran": "ABS(K2-K1)+1",
				"js": "abs( k2 - k1 ) + 1"
			}
		},
		{
			"name": "incx",
			"fortran": "INCX",
			"position": 7,
			"role": "scalar",
			"dtype": "int32",
			"intent": "in"
		}
	],
	"checks": [],
	"quickReturn": [],
	"overrides": [
		{
			"reason": "INCX is both IPIV's stride and the pivot direction (its sign selects reverse order). The JS carries the IPIV stride separately as strideIPIV and keeps INCX as a plain direction scalar, so it is not a consumed increment.",
			"set": {
				"params.INCX.role": "scalar",
				"params.INCX.of": null
			}
		},
		{
			"reason": "The Fortran length K1+(K2-K1)*ABS(INCX) counts IPIV from absolute 1-based K1 with INCX as its stride. The JS takes IPIV's stride separately (strideIPIV) and reads it relative to offsetIPIV, entry 0 for row k1, so it reads |k2-k1|+1 entries (ticket 0068).",
			"set": {
				"params.IPIV.length": {
					"fortran": "ABS(K2-K1)+1",
					"js": "abs( k2 - k1 ) + 1"
				}
			}
		}
	]
}
