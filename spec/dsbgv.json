{
	"routine": "dsbgv",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE DSBGV( JOBZ, UPLO, N, KA, KB, AB, LDAB, BB, LDBB, W, Z,",
	"returns": {
		"kind": "info"
	},
	"params": [
		{
			"name": "jobz",
			"fortran": "JOBZ",
			"position": 1,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "uplo",
			"fortran": "UPLO",
			"position": 2,
			"role": "flag",
			"dtype": "string",
			"intent": "in"
		},
		{
			"name": "N",
			"fortran": "N",
			"position": 3,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "ka",
			"fortran": "KA",
			"position": 4,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "kb",
			"fortran": "KB",
			"position": 5,
			"role": "dim",
			"dtype": "int32",
			"intent": "in"
		},
		{
			"name": "AB",
			"fortran": "AB",
			"position": 6,
			"role": "banded",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDAB",
				"N"
			],
			"ld": "LDAB",
			"rows": {
				"fortran": "KA+1",
				"js": "ka + 1"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldab",
			"fortran": "LDAB",
			"position": 7,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "AB"
		},
		{
			"name": "BB",
			"fortran": "BB",
			"position": 8,
			"role": "banded",
			"dtype": "float64",
			"intent": "inout",
			"dims": [
				"LDBB",
				"N"
			],
			"ld": "LDBB",
			"rows": {
				"fortran": "KB+1",
				"js": "kb + 1"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldbb",
			"fortran": "LDBB",
			"position": 9,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "BB"
		},
		{
			"name": "w",
			"fortran": "W",
			"position": 10,
			"role": "vector",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "Z",
			"fortran": "Z",
			"position": 11,
			"role": "banded",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"LDZ",
				"N"
			],
			"ld": "LDZ",
			"rows": {
				"fortran": "N",
				"js": "N"
			},
			"cols": {
				"fortran": "N",
				"js": "N"
			}
		},
		{
			"name": "ldz",
			"fortran": "LDZ",
			"position": 12,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "Z"
		},
		{
			"name": "WORK",
			"fortran": "WORK",
			"position": 13,
			"role": "workspace",
			"dtype": "float64",
			"intent": "out",
			"dims": [
				"3*N"
			],
			"length": {
				"fortran": "3*N",
				"js": "3 * N"
			},
			"minLength": {
				"fortran": "3*N",
				"js": "3 * N",
				"source": "dimension"
			}
		},
		{
			"name": "info",
			"fortran": "INFO",
			"position": 14,
			"role": "info",
			"dtype": "int32",
			"intent": "out"
		}
	],
	"checks": [
		{
			"info": -1,
			"param": "JOBZ",
			"kind": "enum",
			"fortranValues": "NV",
			"values": [
				"no-vectors",
				"compute-vectors"
			],
			"fortran": ".NOT.( WANTZ .OR. LSAME( JOBZ, 'N' ) )",
			"js": "!(jobz === 'compute-vectors' || jobz === 'no-vectors')"
		},
		{
			"info": -2,
			"param": "UPLO",
			"kind": "enum",
			"fortranValues": "LU",
			"values": [
				"lower",
				"upper"
			],
			"fortran": ".NOT.( UPPER .OR. LSAME( UPLO, 'L' ) )",
			"js": "!(uplo === 'upper' || uplo === 'lower')"
		},
		{
			"info": -3,
			"param": "N",
			"kind": "nonnegative",
			"fortran": "N.LT.0",
			"js": "N < 0"
		},
		{
			"info": -4,
			"param": "KA",
			"kind": "nonnegative",
			"fortran": "KA.LT.0",
			"js": "ka < 0"
		},
		{
			"info": -5,
			"param": "KB",
			"kind": "expr",
			"fortran": "KB.LT.0 .OR. KB.GT.KA",
			"js": "kb < 0 || kb > ka"
		},
		{
			"info": -7,
			"param": "LDAB",
			"kind": "ld",
			"matrix": "AB",
			"min": {
				"fortran": "KA+1",
				"js": "ka + 1"
			},
			"fortran": "LDAB.LT.KA+1",
			"js": "ldab < ka + 1",
			"rowMajor": "ldab < max( 1, N )"
		},
		{
			"info": -9,
			"param": "LDBB",
			"kind": "ld",
			"matrix": "BB",
			"min": {
				"fortran": "KB+1",
				"js": "kb + 1"
			},
			"fortran": "LDBB.LT.KB+1",
			"js": "ldbb < kb + 1",
			"rowMajor": "ldbb < max( 1, N )"
		},
		{
			"info": -12,
			"param": "LDZ",
			"kind": "expr",
			"fortran": "LDZ.LT.1 .OR. ( WANTZ .AND. LDZ.LT.N )",
			"js": "ldz < 1 || (jobz === 'compute-vectors' && ldz < N)"
		}
	],
	"quickReturn": [
		{
			"fortran": "N.EQ.0",
			"js": "N === 0"
		}
	]
}
