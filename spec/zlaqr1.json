{
	"routine": "zlaqr1",
	"package": "lapack",
	"kind": "subroutine",
	"signature": "SUBROUTINE ZLAQR1( N, H, LDH, S1, S2, V )",
	"returns": {
		"kind": "array",
		"param": "v"
	},
	"params": [
		{
			"name": "N",
			"fortran": "N",
			"position": 1,
			"role": "dim",
			"dtype": "int32",
			"intent": "in",
			"reference": "Order of the matrix H. N must be either 2 or 3."
		},
		{
			"name": "H",
			"fortran": "H",
			"position": 2,
			"role": "matrix",
			"dtype": "complex128",
			"intent": "in",
			"dims": [
				"LDH",
				"N"
			],
			"ld": "LDH",
			"cols": {
				"fortran": "N",
				"js": "N"
			},
			"reference": "The 2-by-2 or 3-by-3 matrix H in (\\*)."
		},
		{
			"name": "ldh",
			"fortran": "LDH",
			"position": 3,
			"role": "ld",
			"dtype": "int32",
			"intent": "in",
			"of": "H",
			"reference": "The leading dimension of H as declared in the calling procedure. $\\mathrm{LDH} \\ge N$"
		},
		{
			"name": "s1",
			"fortran": "S1",
			"position": 4,
			"role": "scalar",
			"dtype": "complex128",
			"intent": "in"
		},
		{
			"name": "s2",
			"fortran": "S2",
			"position": 5,
			"role": "scalar",
			"dtype": "complex128",
			"intent": "in",
			"reference": "`S1` and `S2` are the shifts defining K in (\\*) above."
		},
		{
			"name": "v",
			"fortran": "V",
			"position": 6,
			"role": "vector",
			"dtype": "complex128",
			"intent": "out",
			"dims": [
				"N"
			],
			"length": {
				"fortran": "N",
				"js": "N"
			},
			"reference": "A scalar multiple of the first column of the matrix K in (\\*)."
		}
	],
	"checks": [],
	"quickReturn": [
		{
			"fortran": "N.NE.2 .AND. N.NE.3",
			"js": "N !== 2 && N !== 3"
		}
	]
}
